<script src="https://cdn.jsdelivr.net/npm/intl-tel-input@24/build/js/intlTelInput.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/imask/dist/imask.min.js"></script>
<script src="/affiliate.js"></script>
<script src="/form-validation.js"></script>
<script src="/dob-mask.js"></script>
<script>
(function () {
  var formSub = <%- JSON.stringify(formSub) %>;
  var everflowTracking = AffiliateTracking.getTracking();
  var fbTracking = AffiliateTracking.getFbTracking();
  var itiTel;
  var emailValid = false;
  var phoneValid = false;
  var addressValid = false;
  var city = null;
  var stateName = null;

  // Databowl campaign config for the Isolatie funnel (campaign 959).
  var DATABOWL_CID = "959";
  var DATABOWL_SID = "34";

  // All fields below verified against campaign 959's live field list (map.html and the
  // Databowl app directly for stateName, which isn't listed in map.html).
  var LEAD_FIELD_MAP = {
    dob:                 "f_5_dob",
    email:               "f_1_email",
    firstName:           "f_3_firstname",
    lastName:            "f_4_lastname",
    postalCode:          "f_11_postcode",
    phone:               "f_12_phone1",
    city:                "f_40_city",
    stateName:           "f_10_county",
    houseNumber:         "f_167_house_number",
    houseNumberAddition: "f_1070_address_addition",
    street:              "f_991_street_name",
    transaction_id:      "f_331_transaction_id",
    eigenaar:            "f_1717_eigenaar",
    woningtype:          "f_1718_woningtype",
    bouwjaar:            "f_1719_bouwjaar",
    reden:               "f_1720_reden",
    interesse:           "f_1721_interesse",
    planning:            "f_1722_planning",
  };

  var flowSteps = [];
  var step = 0; // 0 = postcode, 1..flowSteps.length = questions, flowSteps.length+1 = form
  var answers = {};
  var postcode = '';

  fetch('/isolatie/questions.json')
    .then(function (r) { return r.json(); })
    .then(function (data) { flowSteps = data; })
    .catch(function (err) { console.error('Kon vragenlijst niet laden.', err); });

  function totalSteps() { return flowSteps.length + 2; }

  function renderProgress() {
    var total = totalSteps();
    var pct = Math.max(Math.round((step / total) * 100), 6);
    document.getElementById('flowProgressFill').style.width = pct + '%';
    document.getElementById('flowStepLabel').textContent = 'Stap ' + (step + 1) + ' van ' + total;
    document.getElementById('flowSub').textContent = step === 0 ? '' : formSub;
    document.getElementById('flowNote').style.display = step === 0 ? '' : 'none';
  }

  function scrollToFlow() {
    document.querySelector('.flow-card').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  document.getElementById('postcodeForm').addEventListener('submit', function (e) {
    e.preventDefault();
    var input = document.getElementById('hpc');
    var errorEl = document.getElementById('hpcError');
    var pc = input.value.trim();
    if (!/^\s*\d{4}\s*[a-zA-Z]{2}\s*$/.test(pc)) {
      errorEl.textContent = 'Voer een geldige postcode in (bijvoorbeeld: 1234 AB)';
      return;
    }
    errorEl.textContent = '';
    postcode = pc.toUpperCase();
    step = 1;
    renderProgress();
    renderStep();
  });

  function renderStep() {
    if (step > flowSteps.length) { renderForm(); return; }
    renderQuestion(flowSteps[step - 1]);
  }

  function renderQuestion(q) {
    var html = '<div class="step-block"><h3>' + q.question + '</h3>';
    if (q.help) html += '<p class="field-sub">' + q.help + '</p>';
    html += '<div class="q-options">';
    q.options.forEach(function (option) {
      if (q.multi) {
        html += '<button type="button" class="q-option" data-value="' + option + '" onclick="isolatieFlow.toggleOption(this)">' +
          option + '<span class="checkbox">✓</span></button>';
      } else {
        html += '<button type="button" class="q-option" data-value="' + option + '" onclick="isolatieFlow.selectOption(this)">' +
          option + '<span class="arrow">→</span></button>';
      }
    });
    html += '</div>';
    if (q.multi) {
      html += '<button type="button" class="flow-submit-btn" id="multiNext" disabled onclick="isolatieFlow.submitMulti()">Volgende →</button>';
    }
    html += '</div>';
    document.getElementById('flowBody').innerHTML = html;
    scrollToFlow();
  }

  function selectOption(el) {
    var q = flowSteps[step - 1];
    answers[q.id] = el.getAttribute('data-value');
    step += 1;
    renderProgress();
    renderStep();
  }

  function toggleOption(el) {
    el.classList.toggle('selected');
    var anySelected = document.querySelectorAll('#flowBody .q-option.selected').length > 0;
    document.getElementById('multiNext').disabled = !anySelected;
  }

  function submitMulti() {
    var q = flowSteps[step - 1];
    var selected = Array.prototype.slice.call(document.querySelectorAll('#flowBody .q-option.selected'))
      .map(function (el) { return el.getAttribute('data-value'); });
    answers[q.id] = selected.join('|');
    step += 1;
    renderProgress();
    renderStep();
  }

  function renderForm() {
    var html =
      '<div class="step-block">' +
      '<h3>Jouw woning komt zeer waarschijnlijk in aanmerking voor een isolatie regeling</h3>' +
      '<p class="field-sub">Vul je gegevens in en ontdek welke subsidieregelingen voor jouw huis gelden.</p>' +
      '<form id="leadForm" novalidate>' +
      '<div class="form-grid" style="margin-top:1rem">' +
      '<label class="field-label"><span>Voornaam *</span><input class="field-input" id="fVoornaam" autocomplete="given-name"/><span class="field-error" id="errVoornaam"></span></label>' +
      '<label class="field-label"><span>Achternaam *</span><input class="field-input" id="fAchternaam" autocomplete="family-name"/><span class="field-error" id="errAchternaam"></span></label>' +
      '<label class="field-label"><span>Geboortedatum *</span><input class="field-input" type="text" id="fDob" placeholder="DD/MM/JJJJ" inputmode="numeric" autocomplete="off"/><span class="field-error" id="errDob"></span></label>' +
      '<label class="field-label"><span>Telefoonnummer *</span><input class="field-input" type="tel" id="fPhone" autocomplete="tel"/><span class="field-status" id="phoneStatus"></span></label>' +
      '<label class="field-label full"><span>E-mailadres *</span><input class="field-input" type="email" id="fEmail" autocomplete="email"/><span class="field-status" id="emailStatus"></span></label>' +
      '<label class="field-label"><span>Straatnaam *</span><input class="field-input" id="fStraat" autocomplete="address-line1" disabled/><span class="field-error" id="errStraat"></span></label>' +
      '<div class="subgrid">' +
      '<label class="field-label"><span>Huisnr. *</span><input class="field-input" id="fHuisnummer" placeholder="12" autocomplete="address-line2"/><span class="field-status" id="addressStatus"></span></label>' +
      '<label class="field-label"><span>Toevoeging</span><input class="field-input" id="fToevoeging" autocomplete="address-line3"/></label>' +
      '</div>' +
      '<label class="field-label"><span>Postcode *</span><input class="field-input" id="fPostcode" placeholder="1234 AB" value="' + postcode + '" autocomplete="postal-code"/><span class="field-error" id="errPostcode"></span></label>' +
      '</div>' +
      '<div class="fcheck"><input type="checkbox" id="fPrivacy"/><label for="fPrivacy">Ik ga akkoord met de <a href="/privacy.html" target="_blank">privacyverklaring</a> en algemene voorwaarden *</label></div>' +
      '<div class="fcheck"><input type="checkbox" id="fNewsletter"/><label for="fNewsletter">Ja, ik ontvang graag tips en aanbiedingen over verduurzamen</label></div>' +
      '<button type="submit" class="flow-submit-btn">Rond mijn aanvraag af →</button>' +
      '<p class="form-note"><i class="fas fa-lock"></i> Je gegevens gebruiken we alleen om je isolatie- en subsidiecheck af te ronden. Geen verplichtingen.</p>' +
      '</form>' +
      '</div>';
    document.getElementById('flowBody').innerHTML = html;
    scrollToFlow();

    DobMask.init(document.getElementById('fDob'));

    itiTel = window.intlTelInput(document.getElementById('fPhone'), {
      initialCountry: 'nl',
      onlyCountries: ['nl'],
      separateDialCode: true,
      allowDropdown: false,
      utilsScript: 'https://cdn.jsdelivr.net/npm/intl-tel-input@24/build/js/utils.js'
    });

    FormValidation.attachAddress(
      function () { return document.getElementById('fPostcode').value.trim(); },
      document.getElementById('fHuisnummer'),
      document.getElementById('fToevoeging'),
      document.getElementById('fStraat'),
      document.getElementById('addressStatus'),
      function (valid, addressData) {
        addressValid = valid;
        if (addressData && addressData.cityName) {
          city = addressData.cityName;
          stateName = addressData.stateName || null;
        }
      }
    );

    FormValidation.attachPhone(
      document.getElementById('fPhone'),
      document.getElementById('phoneStatus'),
      function () { return itiTel ? itiTel.getNumber() : document.getElementById('fPhone').value.trim(); },
      function () { return !itiTel || itiTel.isValidNumber(); },
      function (valid) { phoneValid = valid; }
    );

    FormValidation.attachEmail(
      document.getElementById('fEmail'),
      document.getElementById('emailStatus'),
      function (valid) { emailValid = valid; }
    );

    document.getElementById('leadForm').addEventListener('submit', submitForm);
  }

  function setFieldError(inputId, errorId, message) {
    document.getElementById(inputId).classList.toggle('error', !!message);
    document.getElementById(errorId).textContent = message || '';
  }

  function submitForm(e) {
    e.preventDefault();
    var valid = true;

    ['Voornaam', 'Achternaam'].forEach(function (name) {
      var el = document.getElementById('f' + name);
      if (!el.value.trim()) { setFieldError('f' + name, 'err' + name, 'Vul je ' + name.toLowerCase() + ' in'); valid = false; }
      else { setFieldError('f' + name, 'err' + name, ''); }
    });

    if (!DobMask.validate(document.getElementById('fDob'), document.getElementById('errDob'))) {
      valid = false;
    }

    var postcodeVal = document.getElementById('fPostcode').value.trim();
    if (!/^\s*\d{4}\s*[a-zA-Z]{2}\s*$/.test(postcodeVal)) {
      setFieldError('fPostcode', 'errPostcode', 'Voer een geldige postcode in (bijvoorbeeld: 1234 AB)');
      valid = false;
    } else {
      setFieldError('fPostcode', 'errPostcode', '');
    }

    if (!document.getElementById('fStraat').value.trim()) {
      setFieldError('fStraat', 'errStraat', 'Vul een geldige straatnaam in');
      valid = false;
    } else {
      setFieldError('fStraat', 'errStraat', '');
    }

    if (!emailValid) {
      FormValidation.showError(document.getElementById('fEmail'), document.getElementById('emailStatus'), 'Bevestig een geldig e-mailadres');
      valid = false;
    }
    if (!phoneValid) {
      FormValidation.showError(document.getElementById('fPhone'), document.getElementById('phoneStatus'), 'Bevestig een geldig mobiel nummer');
      valid = false;
    }
    if (!addressValid) {
      FormValidation.showError(document.getElementById('fHuisnummer'), document.getElementById('addressStatus'), 'Combinatie niet gevonden. Controleer je huisnummer.');
      valid = false;
    }
    if (!document.getElementById('fPrivacy').checked) {
      valid = false;
      alert('Je moet akkoord gaan met de privacyverklaring om door te gaan.');
    }

    if (!valid) return;

    var btn = document.querySelector('#leadForm .flow-submit-btn');
    btn.disabled = true;
    btn.textContent = 'Bezig met verzenden...';

    var rawData = {
      dob:                 DobMask.toISO(document.getElementById('fDob')),
      email:               document.getElementById('fEmail').value.trim(),
      firstName:           document.getElementById('fVoornaam').value.trim(),
      lastName:             document.getElementById('fAchternaam').value.trim(),
      postalCode:          postcodeVal,
      city:                city,
      stateName:           stateName,
      houseNumber:         document.getElementById('fHuisnummer').value.trim(),
      houseNumberAddition: document.getElementById('fToevoeging').value.trim(),
      street:              document.getElementById('fStraat').value.trim(),
      phone:               itiTel ? itiTel.getNumber() : document.getElementById('fPhone').value.trim(),
      transaction_id:      everflowTracking.ef_click_id || ''
    };
    for (var key in answers) { rawData[key] = answers[key]; }

    var formData = { newsletter: document.getElementById('fNewsletter').checked, cid: DATABOWL_CID, sid: DATABOWL_SID };
    for (var mapKey in LEAD_FIELD_MAP) {
      var val = rawData[mapKey];
      if (val !== undefined && val !== null && val !== '') formData[LEAD_FIELD_MAP[mapKey]] = val;
    }
    if (everflowTracking.ef_click_id) formData.everflow_tracking = everflowTracking;
    if (fbTracking.fbclid) formData.fb_tracking = fbTracking;

    fetch('/api/lead', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(formData)
    }).then(function (r) { return r.json().then(function (json) { return { status: r.status, json: json }; }); })
      .then(function (result) {
        if (result.json.result === 'created') {
          if (window.va) window.va('event', { name: 'lead_submitted' });
          renderExit(rawData.firstName);
        } else if (result.status === 409) {
          renderExit(rawData.firstName);
        } else {
          console.warn('Lead rejected by Databowl:', result.json);
          btn.disabled = false;
          btn.textContent = 'Rond mijn aanvraag af →';
          alert('Er is een probleem opgetreden bij het verwerken van je aanvraag. Probeer het opnieuw.');
        }
      })
      .catch(function (err) {
        console.error('Lead submission error:', err);
        btn.disabled = false;
        btn.textContent = 'Rond mijn aanvraag af →';
        alert('Er is een technische fout opgetreden. Probeer het later opnieuw.');
      });
  }

  function renderExit(firstName) {
    document.getElementById('flowTitle').style.display = 'none';
    document.getElementById('flowSub').style.display = 'none';
    document.getElementById('flowProgressRow').style.display = 'none';
    document.getElementById('flowNote').style.display = 'none';
    document.getElementById('flowBody').innerHTML =
      '<span class="exit-icon"><i class="fas fa-glass-cheers"></i></span>' +
      '<h2 class="exit-title">Je isolatiecheck is klaar</h2>' +
      '<p class="exit-text">We hebben je aanvraag ontvangen' + (firstName ? ', ' + firstName : '') + '! ' +
      'Ons team gaat je gegevens bekijken en onderzoekt op basis van je postcode welke landelijke en gemeentelijke regelingen beschikbaar zijn voor jouw woning. ' +
      'We nemen spoedig contact met je op om de mogelijkheden voor het isoleren van jouw woning te bespreken en je te helpen bepalen welke aanpak het beste bij jouw situatie past.</p>' +
      '<p class="exit-fine">Subsidiebedragen en voorwaarden hangen af van de maatregel, je woning en de regelingen van je gemeente. We toetsen dat aan de actuele voorwaarden voordat we je iets voorleggen.</p>';
    scrollToFlow();
  }

  window.isolatieFlow = { selectOption: selectOption, toggleOption: toggleOption, submitMulti: submitMulti };
})();
</script>

