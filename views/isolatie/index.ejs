<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1,shrink-to-fit=no"/>
<meta name="description" content="<%= seo.description %>"/>
<title><%= seo.title %></title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800;900&family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css"/>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@24/build/css/intlTelInput.css"/>
<style>
/* ── Design tokens (ported 1:1 from the Lovable source's styles.css) ── */
:root{
  --radius:1rem;
  --radius-sm: calc(var(--radius) - 6px);
  --radius-md: calc(var(--radius) - 3px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 6px);
  --radius-2xl: calc(var(--radius) + 12px);
  --radius-3xl: calc(var(--radius) + 20px);
  --radius-4xl: calc(var(--radius) + 28px);

  --font-display:'Archivo',ui-sans-serif,system-ui,sans-serif;
  --font-sans:'Figtree',ui-sans-serif,system-ui,sans-serif;

  --background: oklch(0.968 0.014 88.5);
  --foreground: oklch(0.235 0.028 158);
  --card: oklch(0.995 0.003 90);
  --card-foreground: oklch(0.235 0.028 158);
  --primary: oklch(0.505 0.114 162);
  --primary-foreground: oklch(0.99 0.004 90);
  --primary-soft: oklch(0.94 0.033 158);
  --secondary: oklch(0.945 0.016 88);
  --muted: oklch(0.945 0.014 88);
  --muted-foreground: oklch(0.49 0.017 158);
  --accent: oklch(0.72 0.198 48);
  --accent-hover: oklch(0.67 0.196 46);
  --accent-foreground: oklch(0.995 0.005 90);
  --warm: oklch(0.79 0.14 62);
  --cool: oklch(0.72 0.09 232);
  --destructive: oklch(0.577 0.245 27.325);
  --border: oklch(0.9 0.012 100);
  --input: oklch(0.9 0.012 100);
  --ring: oklch(0.505 0.114 162);

  --shadow-card: 0 1px 2px oklch(0.24 0.03 160 / 5%), 0 12px 32px -18px oklch(0.24 0.03 160 / 22%);
  --shadow-panel: 0 2px 4px oklch(0.24 0.03 160 / 6%), 0 28px 60px -28px oklch(0.24 0.03 160 / 28%);
  --shadow-cta: 0 10px 24px -10px var(--accent);
}

*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:var(--font-sans);background:var(--background);color:var(--foreground);-webkit-font-smoothing:antialiased}
h1,h2,h3,h4{font-family:var(--font-display);font-weight:800;letter-spacing:-0.025em;margin:0}
p{margin:0}
img{max-width:100%;display:block}
a{color:inherit}
button{font-family:inherit;cursor:pointer}

.container-page{width:100%;margin-inline:auto;max-width:76rem;padding-inline:1.25rem}

/* HEADER */
.site-header{position:sticky;top:0;z-index:40;border-bottom:1px solid color-mix(in oklab, var(--border) 70%, transparent);background:color-mix(in oklab, var(--background) 85%, transparent);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px)}
.site-header .container-page{display:flex;height:4rem;align-items:center;justify-content:space-between;gap:1rem}
.logo-img{width:auto;height:1.5rem}
@media(min-width:640px){.logo-img{height:1.75rem}}

/* URGENCY BAR */
.urgbar{background:var(--accent);padding:0.625rem 1rem;text-align:center;font-size:13px;font-weight:700;color:var(--accent-foreground)}
.urgbar .inner{display:inline-flex;align-items:center;gap:0.5rem}

/* HERO */
.hero{position:relative;overflow:hidden;background:var(--background);color:var(--foreground)}
.hero-bg{position:absolute;inset:0;background-size:cover;background-position:center;opacity:0.24;pointer-events:none}
.hero-inner{position:relative;display:grid;gap:1rem;padding-top:2rem;padding-bottom:1rem;grid-template-columns:1fr}
@media(min-width:1024px){.hero-inner{grid-template-columns:1.1fr 0.9fr;gap:3rem;padding-top:2.5rem;padding-bottom:1.5rem}}
.hero-copy{min-width:0;grid-row:1;grid-column:1}
.hero-copy h1{margin-top:0;white-space:pre-line;font-size:1.95rem;line-height:1.08}
@media(min-width:640px){.hero-copy h1{font-size:2.25rem}}
@media(min-width:1024px){.hero-copy h1{font-size:3rem}}
.hero-copy h1 .hl{color:var(--accent)}
.hero-copy .sub{margin-top:1rem;max-width:36rem;font-size:15px;line-height:1.6;color:var(--foreground)}
@media(min-width:640px){.hero-copy .sub{font-size:16px}}
.hero-flow{min-width:0;grid-row:2;grid-column:1;scroll-margin-top:6rem}
@media(min-width:1024px){.hero-flow{grid-row:1/span 2;grid-column:2;align-self:center}}
.hero-stats{grid-row:3;grid-column:1}
@media(min-width:1024px){.hero-stats{grid-row:2;grid-column:1}}
.stat-grid{margin-top:0.5rem;display:grid;grid-template-columns:1fr;gap:0.75rem}
@media(min-width:640px){.stat-grid{grid-template-columns:repeat(3,1fr)}}
.stat-card{display:flex;align-items:center;gap:0.75rem;border-radius:var(--radius-2xl);border:1px solid var(--border);background:var(--card);padding:0.875rem;box-shadow:var(--shadow-card)}
@media(min-width:640px){.stat-card{display:block}}
.stat-card .v{flex-shrink:0;font-size:1.25rem;font-weight:800;color:var(--foreground)}
@media(min-width:640px){.stat-card .v{font-size:1.5rem}}
.stat-card .l{margin-top:0;font-size:12px;line-height:1.35;color:var(--muted-foreground)}
@media(min-width:640px){.stat-card .l{margin-top:0.25rem;display:block}}

/* CTA BUTTON */
.cta-btn{display:inline-flex;width:100%;align-items:center;justify-content:center;gap:0.5rem;border-radius:var(--radius-2xl);background:var(--accent);padding:1rem 1.5rem;text-align:center;font-size:1rem;font-weight:800;letter-spacing:0.01em;color:var(--accent-foreground);box-shadow:var(--shadow-cta);border:none;text-decoration:none;transition:background-color .15s}
.cta-btn:hover{background:var(--accent-hover);color:var(--accent-foreground)}
@media(min-width:640px){.cta-btn{width:auto}}

/* TRUST BAR */
.trustbar{background:var(--primary-soft);padding:0.625rem 1rem;text-align:center;font-size:13px;font-weight:700;color:var(--primary)}
.trustbar .inner{display:inline-flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:0.375rem 1.5rem}
.trustbar .item{display:flex;align-items:center;gap:0.375rem}

/* FLOW CARD (postcode step) */
.flow-card{border-radius:var(--radius-3xl);border:1px solid var(--border);background:var(--card);padding:1.25rem;color:var(--card-foreground);box-shadow:var(--shadow-panel)}
@media(min-width:640px){.flow-card{padding:1.75rem}}
.flow-card h2{font-size:1.25rem;font-weight:800;color:var(--primary)}
@media(min-width:640px){.flow-card h2{font-size:1.5rem}}
.flow-progress-row{margin-top:1.25rem;display:flex;align-items:center;gap:0.75rem}
.flow-progress-track{height:0.5rem;flex:1;overflow:hidden;border-radius:9999px;background:var(--muted)}
.flow-progress-fill{height:100%;border-radius:9999px;background:var(--primary);transition:width .3s}
.flow-progress-row .steplabel{flex-shrink:0;font-size:12px;font-weight:600;color:var(--muted-foreground)}
.flow-card form{margin-top:1.5rem}
.step-block{margin-top:1.5rem}
.flow-card h3{font-size:1.125rem;font-weight:700;color:var(--foreground)}
@media(min-width:640px){.flow-card h3{font-size:1.25rem}}
.postcode-title{color:var(--primary)}
.flow-card .field-sub{margin-top:0.375rem;font-size:14px;color:var(--muted-foreground)}
.field-label{display:block}
.field-label span{margin-bottom:0.375rem;display:block;font-size:12px;font-weight:600;color:var(--muted-foreground)}
.field-input{height:3rem;width:100%;border-radius:var(--radius-xl);border:1px solid var(--input);background:var(--background);padding:0 0.875rem;font-size:15px;outline:none;transition:border-color .15s}
.field-input:focus{border-color:var(--primary);box-shadow:0 0 0 2px color-mix(in oklab, var(--ring) 25%, transparent)}
.field-error{margin-top:0.375rem;display:block;font-size:12px;font-weight:500;color:var(--destructive)}
.flow-note{margin-top:1rem;text-align:center;font-size:12px;color:var(--muted-foreground)}
.flow-submit-btn{display:block;width:100%;margin-top:1.25rem;border:none;border-radius:var(--radius-2xl);background:var(--accent);padding:1rem 1.25rem;text-align:center;font-size:1rem;font-weight:800;text-transform:uppercase;letter-spacing:0.025em;color:var(--accent-foreground);box-shadow:var(--shadow-cta);transition:background-color .15s}
.flow-submit-btn:hover{background:var(--accent-hover)}
.flow-submit-btn:disabled{opacity:0.4;cursor:not-allowed}
.flow-submit-btn:disabled:hover{background:var(--accent)}

/* LEAD FORM */
.form-grid{display:grid;gap:0.75rem}
@media(min-width:640px){.form-grid{grid-template-columns:1fr 1fr}}
.form-grid .full{grid-column:1/-1}
.subgrid{display:grid;grid-template-columns:1fr 1fr;gap:0.75rem}
.field-input.valid{border-color:var(--success)}
.field-input.error{border-color:var(--destructive)}
.field-input:disabled{background:var(--muted);color:var(--muted-foreground);cursor:not-allowed}
.field-status{margin-top:0.375rem;font-size:12px}
.iti{width:100%}
.iti__tel-input{height:3rem;width:100%;border-radius:var(--radius-xl);border:1px solid var(--input);background:var(--background);padding:0 0.875rem 0 4.5rem;font-size:15px;outline:none}
.iti__tel-input:focus{border-color:var(--primary);box-shadow:0 0 0 2px color-mix(in oklab, var(--ring) 25%, transparent)}
.fcheck{display:flex;align-items:flex-start;gap:0.55rem;margin-top:0.9rem}
.fcheck input{margin-top:0.2rem;width:17px;height:17px;flex-shrink:0}
.fcheck label{font-size:13px;color:var(--muted-foreground);line-height:1.5}
.fcheck label a{color:var(--primary);text-decoration:underline}
.form-note{margin-top:0.75rem;display:flex;align-items:flex-start;justify-content:center;gap:0.375rem;text-align:center;font-size:12px;color:var(--muted-foreground)}

/* EXIT SCREEN */
.exit-icon{display:inline-flex;align-items:center;justify-content:center;width:3rem;height:3rem;border-radius:var(--radius-2xl);background:var(--primary-soft);color:var(--primary);font-size:1.35rem}
.flow-card .exit-title{margin-top:1.25rem;font-size:1.5rem;color:var(--foreground)}
@media(min-width:640px){.flow-card .exit-title{font-size:1.875rem}}
.exit-text{margin-top:0.75rem;color:var(--muted-foreground);font-size:15px;line-height:1.7}
.exit-fine{margin-top:1.5rem;font-size:12px;color:var(--muted-foreground)}

/* QUESTION OPTIONS */
.q-options{margin-top:1rem;display:grid;gap:0.625rem}
.q-option{display:flex;width:100%;align-items:center;justify-content:space-between;gap:0.75rem;border-radius:var(--radius-2xl);border:1px solid var(--border);background:var(--background);padding:1rem;text-align:left;font-size:15px;font-weight:600;color:var(--foreground);transition:transform .15s,border-color .15s,background-color .15s}
.q-option:hover{border-color:var(--primary);background:var(--primary-soft);transform:translateY(-2px)}
.q-option.selected{border-color:var(--primary);background:var(--primary-soft)}
.q-option .arrow{flex-shrink:0;color:var(--muted-foreground);transition:color .15s}
.q-option:hover .arrow{color:var(--primary)}
.q-option .checkbox{flex-shrink:0;display:flex;align-items:center;justify-content:center;width:1.25rem;height:1.25rem;border-radius:6px;border:1px solid var(--border);background:var(--background);color:transparent;font-size:11px;transition:background-color .15s,border-color .15s,color .15s}
.q-option.selected .checkbox{border-color:var(--primary);background:var(--primary);color:var(--primary-foreground)}

/* BENEFITS */
.benefits-section{padding-top:2rem;padding-bottom:1rem}
@media(min-width:640px){.benefits-section{padding-top:2.5rem;padding-bottom:1.5rem}}
.benefits-grid{display:grid;gap:2rem}
@media(min-width:1024px){.benefits-grid{grid-template-columns:1fr 1fr;align-items:center;gap:3rem}}
.benefits-image-wrap{order:2}
@media(min-width:1024px){.benefits-image-wrap{order:0}}
.benefits-image-wrap img{aspect-ratio:4/3;width:100%;border-radius:var(--radius-4xl);object-fit:cover;box-shadow:var(--shadow-card)}
.benefits-copy{min-width:0}
.benefits-copy h2{max-width:42rem;font-size:1.5rem}
@media(min-width:640px){.benefits-copy h2{font-size:1.875rem}}
.benefit-list{list-style:none;margin:1.5rem 0 0;padding:0;display:flex;flex-direction:column;gap:1.25rem}
.benefit-item{display:flex;gap:0.875rem}
.benefit-icon{margin-top:0.125rem;flex-shrink:0;display:inline-flex;height:2.25rem;width:2.25rem;align-items:center;justify-content:center;border-radius:var(--radius-xl);background:var(--primary-soft);color:var(--primary);font-size:1.1rem}
.benefit-item h3{font-size:1rem;font-weight:700}
.benefit-item p{margin-top:0.25rem;font-size:14px;line-height:1.6;color:var(--muted-foreground)}

/* COMPARE */
.compare-section{padding-top:1.5rem;padding-bottom:1rem}
@media(min-width:640px){.compare-section{padding-top:2rem;padding-bottom:1.5rem}}
.compare-section h2{font-size:1.5rem}
@media(min-width:640px){.compare-section h2{font-size:1.875rem}}
.compare-grid{margin-top:1.5rem;display:grid;align-items:start;gap:1rem}
@media(min-width:768px){.compare-grid{grid-template-columns:1fr 1fr}}
.compare-card{border-radius:var(--radius-3xl);padding:1.25rem}
.compare-card--before{border:1px solid var(--border);background:linear-gradient(180deg, color-mix(in oklab, var(--warm) 20%, transparent), transparent)}
.compare-card--after{border:1px solid color-mix(in oklab, var(--primary) 30%, transparent);background:var(--primary-soft)}
.compare-card .title{display:flex;align-items:center;gap:0.5rem;font-size:14px;font-weight:800}
.compare-card--before .title i{color:var(--cool)}
.compare-card--after .title i{color:var(--primary)}
.compare-card p{margin-top:0.625rem;white-space:pre-line;font-size:14px;line-height:1.6;color:var(--muted-foreground)}

/* GAS PRICE BANNER */
.gas-banner-section{padding-top:0.75rem;padding-bottom:0.75rem}
@media(min-width:640px){.gas-banner-section{padding-top:1rem;padding-bottom:1rem}}
.gas-banner{display:flex;flex-direction:column;align-items:center;gap:1.25rem;border-radius:var(--radius-2xl);background:var(--foreground);padding:1.75rem}
@media(min-width:640px){.gas-banner{flex-direction:row;justify-content:space-between;padding:2rem 2.25rem}}
.gas-banner .copy{max-width:36rem;text-align:center}
@media(min-width:640px){.gas-banner .copy{text-align:left}}
.gas-banner .kicker{font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:0.2em;color:color-mix(in oklab, var(--background) 50%, transparent)}
.gas-banner h2{margin-top:0.375rem;font-size:1.25rem;font-weight:900;line-height:1.25;color:var(--background)}
@media(min-width:640px){.gas-banner h2{font-size:1.5rem}}
.gas-banner p{margin-top:0.5rem;font-size:14px;line-height:1.5;color:color-mix(in oklab, var(--background) 70%, transparent)}
.gas-banner p.dim{color:color-mix(in oklab, var(--background) 60%, transparent)}
.gas-banner .source{margin-top:0.625rem;display:flex;align-items:center;justify-content:center;gap:0.5rem;font-size:11px;font-weight:600;color:color-mix(in oklab, var(--background) 50%, transparent)}
@media(min-width:640px){.gas-banner .source{justify-content:flex-start}}
.gas-banner .source img{height:1.25rem;width:auto;border-radius:3px;background:#fff;padding:0.125rem 0.25rem}
.gas-banner .cta-wrap{flex-shrink:0;display:flex;width:100%}
@media(min-width:640px){.gas-banner .cta-wrap{width:auto}}

/* FUNDS */
.funds-section{padding-top:1rem;padding-bottom:1rem}
@media(min-width:640px){.funds-section{padding-top:1.5rem;padding-bottom:1.5rem}}
.funds-section h2{max-width:42rem;font-size:1.5rem}
@media(min-width:640px){.funds-section h2{font-size:1.875rem}}
.funds-section > .container-page > p{margin-top:0.75rem;max-width:42rem;font-size:14px;line-height:1.6;color:var(--muted-foreground)}
@media(min-width:640px){.funds-section > .container-page > p{font-size:16px}}
.funds-grid{margin-top:1.5rem;display:grid;gap:1rem}
@media(min-width:640px){.funds-grid{grid-template-columns:1fr 1fr}}
.funds-card{border-radius:var(--radius-3xl);border:1px solid var(--border);background:var(--card);padding:1.25rem;box-shadow:var(--shadow-card)}
.funds-card h3{display:flex;align-items:center;gap:0.5rem;font-size:1rem;font-weight:700}
.funds-card h3 i{color:var(--primary)}
.funds-card p{margin-top:0.5rem;font-size:14px;line-height:1.6;color:var(--muted-foreground);white-space:pre-line}

/* REVIEWS */
.reviews-section{padding-top:3rem;padding-bottom:3rem}
@media(min-width:640px){.reviews-section{padding-top:4rem;padding-bottom:4rem}}
.reviews-head{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:1rem}
.reviews-head h2{max-width:42rem;font-size:1.5rem}
@media(min-width:640px){.reviews-head h2{font-size:1.875rem}}
.rating-badge{display:inline-flex;align-items:center;gap:0.5rem;border-radius:9999px;background:var(--card);padding:0.375rem 0.875rem;font-size:12px;font-weight:700;color:var(--primary)}
.rating-badge .stars{color:var(--accent)}
.reviews-grid{margin-top:1.5rem;display:grid;gap:1rem}
@media(min-width:640px){.reviews-grid{grid-template-columns:repeat(3,1fr)}}
.review-card{display:flex;flex-direction:column;border-radius:var(--radius-3xl);border:1px solid var(--border);background:var(--card);padding:1.25rem}
.review-card .stars{color:var(--accent);font-size:14px}
.review-card blockquote{margin:0.75rem 0 0;flex:1;font-size:14px;line-height:1.6}
.review-card .who{margin-top:1rem;border-top:1px solid var(--border);padding-top:0.75rem}
.review-card .who .name{display:block;font-size:14px;font-weight:800}
.review-card .who .meta{display:block;font-size:12px;color:var(--muted-foreground)}

/* FINAL CTA */
.final-cta-section{padding-bottom:3.5rem}
.final-cta{border-radius:var(--radius-4xl);background:var(--foreground);padding:2.5rem 1.25rem;text-align:center}
@media(min-width:640px){.final-cta{padding:3rem}}
.final-cta h2{margin:0 auto;max-width:42rem;font-size:1.5rem;color:var(--background)}
@media(min-width:640px){.final-cta h2{font-size:2.25rem}}
.final-cta p{margin:0.75rem auto 0;max-width:36rem;font-size:15px;color:color-mix(in oklab, var(--background) 75%, transparent)}
.final-cta .cta-wrap{margin-top:1.5rem;display:flex;justify-content:center}
.final-cta .cta-wrap .cta-btn{width:auto}
.variant-pills{margin-top:2rem;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:0.5rem}
.variant-pills a{border-radius:9999px;border:1px solid color-mix(in oklab, var(--background) 25%, transparent);padding:0.375rem 0.75rem;font-size:12px;font-weight:600;color:color-mix(in oklab, var(--background) 70%, transparent);text-decoration:none}

/* FOOTER */
.site-footer{border-top:1px solid var(--border);background:var(--card)}
.footer-top{display:flex;flex-direction:column;gap:1.5rem;padding:2.5rem 0}
@media(min-width:640px){.footer-top{flex-direction:row;align-items:flex-start;justify-content:space-between}}
.footer-about{max-width:28rem}
.footer-about p{margin-top:0.75rem;font-size:14px;color:var(--muted-foreground)}
.footer-about p.fine{margin-top:0.5rem;font-size:12px}
.footer-links{display:grid;grid-template-columns:1fr 1fr;align-items:start;gap:1.5rem;font-size:14px;color:var(--muted-foreground)}
@media(min-width:640px){.footer-links{gap:2.5rem}}
.footer-links .col{display:flex;flex-direction:column;gap:0.5rem}
.footer-links .col .head{font-weight:600;color:var(--foreground)}
.footer-links .col a{text-decoration:none;transition:color .15s}
.footer-links .col a:hover{color:var(--foreground)}
.footer-bottom{border-top:1px solid var(--border);padding:1.25rem 0;font-size:12px;color:var(--muted-foreground)}
</style>

<script type="text/javascript">
  (function(c,l,a,r,i,t,y){
    c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
    t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
    y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
  })(window, document, "clarity", "script", "<%= clarityId %>");
</script>

<!-- Meta Pixel Code -->
<script>
  !function(f,b,e,v,n,t,s)
  {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
          n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
          'https://connect.facebook.net/en_US/fbevents.js');
  fbq('init', '4513411092222816');
  fbq('track', 'PageView');
</script>
