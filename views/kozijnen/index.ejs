<script src="/form-validation.js"></script>
<script>
(function(){
  'use strict';

  /* =====================================================================
     INSTELLINGEN: vul in zodra je installatiepartner het bevestigt
     ===================================================================== */
  var CONFIG = {
    webhookUrl: '',                                   // POST-endpoint voor leads (JSON). Leeg = niet versturen
    beltermijn: 'binnen 2 werkdagen',                 // termijn die de adviseur echt haalt
    bedrijfsnaam: 'VerdienDuurzaam en haar installatiepartner',
    levertijd: '',                                    // bijv. '6 tot 8 weken'. Leeg = "een aantal weken"
    laatsteOrderDatum: '',                            // bijv. '2026-11-21'. Leeg = regel niet tonen
    bron: 'verdienduurzaam-kozijnen'
  };
  /* ===================================================================== */

  var DEADLINE = new Date('2027-01-01T00:00:00+01:00');
  var MAANDEN = ['januari','februari','maart','april','mei','juni','juli','augustus','september','oktober','november','december'];
  var ORDER = ['pc','eigendom','bouwjaar','kozijnen','glas','reden','aantal','termijn','gegevens','bedankt'];
  var TOTAL_Q = 8;
  var PC_RE = /^[1-9][0-9]{3}\s?[A-Za-z]{2}$/;

  var data = {};
  var current = null;
  var addressValid = false;

  /* ---------- helpers ---------- */
  function $(s, r){ return (r || document).querySelector(s); }
  function $$(s, r){ return Array.prototype.slice.call((r || document).querySelectorAll(s)); }
  function setHTML(id, html){ var el = document.getElementById(id); if (el) el.innerHTML = html; }
  function normPc(v){ v = (v || '').replace(/\s+/g, '').toUpperCase(); return v.length === 6 ? v.slice(0,4) + ' ' + v.slice(4) : v; }
  function getParam(k){ var m = new RegExp('[?&]' + k + '=([^&]*)').exec(window.location.search); return m ? decodeURIComponent(m[1].replace(/\+/g, ' ')) : ''; }
  function eur(n){ return '€' + n.toLocaleString('nl-NL'); }
  function daysLeft(){ return Math.max(0, Math.ceil((DEADLINE.getTime() - Date.now()) / 86400000)); }
  function pushUrl(){ try { window.history.pushState({ flow: 1 }, '', window.location.pathname + window.location.search + '#subsidiecheck'); } catch (e) {} }

  /* Groningen + Aa en Hunze, Noordenveld, Tynaarlo: grofweg 93xx en 945x-99xx (zonder Borger-Odoorn 952x-954x).
     Signaal, geen uitsluiting: de bezoeker krijgt een aangepaste tekst en de lead krijgt een vlag. */
  function groningenRegio(pc){
    var n = parseInt(pc.slice(0,4), 10);
    return (n >= 9300 && n <= 9399) || (n >= 9450 && n <= 9519) || (n >= 9550 && n <= 9999);
  }

  /* ---------- teksten uit instellingen + aftellen ---------- */
  $$('.js-belt').forEach(function(el){ el.textContent = CONFIG.beltermijn; });
  $$('.js-bedrijf').forEach(function(el){ el.textContent = CONFIG.bedrijfsnaam; });
  if (CONFIG.levertijd) $$('.js-levertijd').forEach(function(el){ el.textContent = CONFIG.levertijd; });

  (function(){
    var d = daysLeft();
    if (d > 0) {
      var dagen = d === 1 ? 'dag' : 'dagen';
      setHTML('topCount', 'nog ' + d + ' ' + dagen + ' het volle bedrag');
      setHTML('heroCount', 'Nog <strong>' + d + ' ' + dagen + '</strong> tot de subsidie omlaaggaat');
      setHTML('stickyCount', 'Nog ' + d + ' ' + dagen + ' het volle bedrag');
      setHTML('fTopCount', 'nog ' + d + ' ' + dagen + ' €111 per m²');
    } else {
      setHTML('heroCount', 'De verlaging is per 1 januari 2027 ingegaan');
    }
    if (CONFIG.laatsteOrderDatum) {
      var od = new Date(CONFIG.laatsteOrderDatum + 'T23:59:59+01:00');
      if (!isNaN(od) && od.getTime() > Date.now()) {
        var line = $('#deadlineLine');
        line.textContent = 'Bestellen vóór ' + od.getDate() + ' ' + MAANDEN[od.getMonth()] + ', dan staan je kozijnen er nog dit jaar.';
        line.hidden = false;
      }
    }
  })();

  /* =====================================================================
     LANDINGSPAGINA
     ===================================================================== */

  /* Postcodevelden: geen <form>, zodat het ook werkt in previews die formulieren blokkeren */
  $$('.js-pc').forEach(function(box){
    var input = $('input', box);
    function go(){
      var v = input.value.trim();
      if (!PC_RE.test(v)) { box.classList.add('has-err'); input.focus(); return; }
      box.classList.remove('has-err');
      openFlow(normPc(v));
    }
    input.addEventListener('input', function(){ box.classList.remove('has-err'); });
    input.addEventListener('blur', function(){ if (PC_RE.test(input.value.trim())) input.value = normPc(input.value); });
    input.addEventListener('keydown', function(e){ if (e.key === 'Enter') { e.preventDefault(); go(); } });
    $('.js-pc-go', box).addEventListener('click', go);
  });

  /* Rekenslider */
  var slider = $('#m2');
  function calc(){
    var m = parseInt(slider.value, 10);
    setHTML('m2val', m + ' m²');
    setHTML('o26', eur(m * 111));
    setHTML('o27', eur(m * 55));
    setHTML('odiff', eur(m * 56));
  }
  if (slider) { slider.addEventListener('input', calc); calc(); }

  /* FAQ */
  $$('.faq-q').forEach(function(q){
    q.addEventListener('click', function(){
      var open = q.parentNode.classList.toggle('open');
      q.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  });

  /* Sticky knop (alleen mobiel/tablet, via CSS): tonen na de hero, verbergen bij de check-sectie */
  var sticky = $('#sticky'), hero = $('#top'), check = $('#check');
  function onScroll(){
    if ($('#landing').hidden) return;
    var y = window.pageYOffset;
    var heroEnd = hero.offsetTop + hero.offsetHeight;
    var cTop = check.offsetTop - window.innerHeight * 0.6, cEnd = check.offsetTop + check.offsetHeight;
    sticky.classList.toggle('show', y > heroEnd && !(y > cTop && y < cEnd));
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  /* =====================================================================
     VRAGENFLOW
     ===================================================================== */
  var landingEl = $('#landing'), flowEl = $('#flow');
  function stepEl(name){ return $('.q[data-step="' + name + '"]'); }
  function nextOf(name){ return ORDER[ORDER.indexOf(name) + 1]; }

  function progress(name){
    var p = $('#progress'), q = stepEl(name).getAttribute('data-q');
    if (name === 'bedankt' || name === 'huur') { p.hidden = true; return; }
    p.hidden = false;
    var pct = Math.round((ORDER.indexOf(name) / (ORDER.length - 1)) * 100);
    $('#pLabel').textContent = q ? 'Vraag ' + q + ' van ' + TOTAL_Q : 'Laatste stap';
    $('#pPct').textContent = pct + '%';
    $('#pBar').style.width = pct + '%';
  }

  function show(name){
    $$('.q').forEach(function(el){ el.classList.remove('active'); });
    stepEl(name).classList.add('active');
    current = name;
    progress(name);
    if (name === 'gegevens' && $('#postcode').value !== data.postcode) { $('#postcode').value = data.postcode || ''; addressValid = false; lookupAddress(); }
    try { (window.dataLayer = window.dataLayer || []).push({ event: 'flow_step', flow: 'kozijnen', step: name }); } catch (e) {}
    window.scrollTo(0, 0);
  }

  function setPc(v){
    data.postcode = normPc(v);
    data.regio_groningen = groningenRegio(data.postcode);
    var banner = $('#pcBanner');
    banner.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#15803d" stroke-width="2.5" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>' +
      '<span>Postcode <b>' + data.postcode + '</b> neemt de adviseur mee in je check.</span><button type="button" id="pcEdit">Wijzig</button>';
    banner.hidden = false;
    $('#pcEdit').addEventListener('click', function(){ show('pc'); });
    $('#regioNote').hidden = !data.regio_groningen;
  }

  function openFlow(pc){
    landingEl.hidden = true;
    flowEl.hidden = false;
    $('#pc').value = normPc(pc);
    setPc(pc);
    show('eigendom');
    pushUrl();
  }
  function closeFlow(){
    flowEl.hidden = true;
    landingEl.hidden = false;
  }
  window.addEventListener('popstate', function(){
    if (current === 'bedankt') { pushUrl(); return; }   // na verzenden niet terug naar het formulier
    if (!flowEl.hidden) closeFlow();
  });

  /* Vraag 1 (alleen zichtbaar via "Wijzig") */
  $('#pcNext').addEventListener('click', function(){
    var v = $('#pc').value.trim(), f = $('#f-pc');
    if (!PC_RE.test(v)) { f.classList.add('bad'); $('#pc').focus(); return; }
    f.classList.remove('bad');
    setPc(v);
    show('eigendom');
  });
  $('#pc').addEventListener('keydown', function(e){ if (e.key === 'Enter') $('#pcNext').click(); });

  /* Keuzevragen: klik = opslaan en door */
  var FEEDBACK = {
    aantal: function(v){
      if (v === 'Meer dan 10' || v === 'Het hele huis') return 'Bij dat aantal kom je waarschijnlijk in aanmerking voor het maximale subsidiebedrag.';
      if (v === '7 tot 10') return 'Bij dat aantal kom je al snel richting een flink subsidiebedrag.';
      return '';
    },
    termijn: function(v){
      return v === 'Dit jaar nog' ? 'Goed dat je dit weet. De adviseur kijkt meteen of opmeten en plaatsen nog dit jaar lukt.' : '';
    }
  };
  $$('.q[data-q]').forEach(function(st){
    var name = st.getAttribute('data-step');
    var opts = $$('.opt', st);
    opts.forEach(function(btn){
      btn.addEventListener('click', function(){
        var v = btn.getAttribute('data-v');
        opts.forEach(function(o){ o.classList.remove('sel'); });
        btn.classList.add('sel');
        data[name] = v;
        var msg = FEEDBACK[name] ? FEEDBACK[name](v) : '', fb = $('#fb-' + name);
        if (fb) { fb.textContent = msg; fb.classList.toggle('show', !!msg); }
        setTimeout(function(){
          if (current !== name) return;
          show(name === 'eigendom' && v === 'Huurwoning' ? 'huur' : nextOf(name));
        }, msg ? 1500 : 260);
      });
    });
  });

  $$('[data-to]').forEach(function(b){ b.addEventListener('click', function(){ show(b.getAttribute('data-to')); }); });

  /* Formulier */
  $$('#aanhef button').forEach(function(b, i, all){
    b.addEventListener('click', function(){
      all.forEach(function(x){ x.classList.remove('sel'); });
      b.classList.add('sel');
      data.aanhef = b.getAttribute('data-v');
      $('#f-aanhef').classList.remove('bad');
    });
  });
  $$('.field .input').forEach(function(inp){ inp.addEventListener('input', function(){ inp.parentNode.classList.remove('bad'); }); });
  $('#consent').addEventListener('change', function(){ $('#consentWrap').classList.remove('bad'); });

  function validate(id, test){
    var v = $('#' + id).value.trim(), ok = test(v);
    $('#f-' + id).classList.toggle('bad', !ok);
    return ok ? v : null;
  }
  function normTel(v){
    v = v.replace(/[\s\-\.\(\)]/g, '');
    if (v.indexOf('+31') === 0) v = '0' + v.slice(3);
    if (v.indexOf('0031') === 0) v = '0' + v.slice(4);
    return v;
  }

  /* Adres: postcode + huisnummer vullen straat en plaats aan. De postcode blijft
     aanpasbaar, en straat en plaats ook (voor het geval de lookup ernaast zit). */
  var addrStatus = $('#addrStatus');
  var lookupAddress = FormValidation.attachAddress(
    function(){ return $('#postcode').value; }, $('#huisnr'), $('#toevoeging'), $('#straat'), addrStatus,
    function(valid, address){
      addressValid = valid;
      if (valid) {
        $('#plaats').value = address.cityName || '';
        ['f-huisnr','f-straat','f-plaats'].forEach(function(id){ $('#' + id).classList.remove('bad'); });
        addrStatus.textContent = 'Adres gevonden.';
        addrStatus.style.color = 'var(--green)';
      } else {
        $('#plaats').value = '';
      }
    }
  );
  $('#postcode').addEventListener('change', function(){
    var v = $('#postcode').value.trim();
    addressValid = false;
    if (!PC_RE.test(v)) { $('#f-postcode').classList.add('bad'); return; }
    $('#f-postcode').classList.remove('bad');
    $('#postcode').value = normPc(v);
    setPc(v);
    lookupAddress();
  });

  $('#submitBtn').addEventListener('click', function(){
    var btn = this;
    var aOk = !!data.aanhef; $('#f-aanhef').classList.toggle('bad', !aOk);
    var vn = validate('voornaam', function(v){ return v.length >= 2; });
    var an = validate('achternaam', function(v){ return v.length >= 2; });
    var pc = validate('postcode', function(v){ return PC_RE.test(v); });
    var hn = validate('huisnr', function(v){ return /^[0-9]+$/.test(v); });
    var st = validate('straat', function(v){ return v.length >= 2; });
    var pl = validate('plaats', function(v){ return v.length >= 2; });
    if (pc && hn && !addressValid) {
      addrStatus.textContent = 'Combinatie niet gevonden. Controleer je postcode en huisnummer.';
      addrStatus.style.color = 'var(--red)';
      $('#huisnr').classList.add('error');
    }
    var em = validate('email', function(v){ return /^[^\s@]+@[^\s@]+\.[a-z]{2,}$/i.test(v); });
    var tel = normTel($('#tel').value.trim()), telOk = /^0[1-9][0-9]{8}$/.test(tel);
    $('#f-tel').classList.toggle('bad', !telOk);
    var cOk = $('#consent').checked; $('#consentWrap').classList.toggle('bad', !cOk);

    if (!(aOk && vn && an && pc && hn && addressValid && st && pl && em && telOk && cOk)) {
      var bad = $('#flow .bad, #flow .input.error'); if (bad && bad.scrollIntoView) bad.scrollIntoView({ block: 'center', behavior: 'smooth' });
      return;
    }

    setPc(pc);
    data.voornaam = vn; data.achternaam = an; data.huisnummer = hn; data.toevoeging = $('#toevoeging').value.trim();
    data.straat = st; data.plaats = pl; data.email = em;
    data.telefoon = tel; data.toestemming = true;
    data.bron = CONFIG.bron; data.tijdstip = new Date().toISOString(); data.pagina = window.location.href;
    ['utm_source','utm_medium','utm_campaign','utm_content','utm_term','sub_id','click_id'].forEach(function(k){ var v = getParam(k); if (v) data[k] = v; });

    btn.disabled = true; btn.textContent = 'Even geduld...';
    var done = false;
    function finish(){ if (done) return; done = true; show('bedankt'); }
    if (CONFIG.webhookUrl && window.fetch) {
      try {
        fetch(CONFIG.webhookUrl, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data), keepalive: true }).then(finish, finish);
        setTimeout(finish, 4000);
      } catch (e) { finish(); }
    } else {
      finish();
    }
  });
  $('#tel').addEventListener('keydown', function(e){ if (e.key === 'Enter') $('#submitBtn').click(); });

  /* Postcode al in de URL (bijv. vanuit een advertentie)? Dan meteen de flow */
  var urlPc = getParam('pc');
  if (urlPc && PC_RE.test(urlPc.trim())) openFlow(urlPc);
})();
</script>
<script src="/affiliate.js"></script>
<script>
  window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
</script>
<script defer src="/_vercel/insights/script.js"></script>
<script defer src="/_vercel/speed-insights/script.js"></script>
</body>
