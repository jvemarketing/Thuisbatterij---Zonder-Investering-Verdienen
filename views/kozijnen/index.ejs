<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0f5f2d">
<title>Kunststof kozijnen met subsidie: dit jaar nog €111 per m² | VerdienDuurzaam</title>
<meta name="description" content="Voor triple glas in nieuwe kozijnen krijg je nu €111 per m² landelijke subsidie. Vanaf 1 januari 2027 is dat €55. Check je postcode en ontdek wat jij nog kunt krijgen.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
/* =====================================================================
   VerdienDuurzaam · Kozijnen funnel
   Mobile first: basisregels zijn voor telefoons (vanaf 320px).
   Grotere schermen krijgen extra regels via min-width breakpoints:
     sm  >= 640px   (grote telefoon liggend, kleine tablet)
     lg  >= 960px   (tablet liggend, desktop)
   ===================================================================== */

/* ---------- 1. Tokens ---------- */
:root{
  --green:#15803d; --green-dark:#0f5f2d; --green-soft:#ecf7ef; --green-line:#cfe9d7;
  --orange:#ea580c; --orange-dark:#c2410c; --orange-soft:#fff3eb; --orange-line:#fcd2b6;
  --ink:#16201a; --body:#3b4a40; --muted:#6b7a70; --line:#e3e8e4;
  --bg:#f5f8f6; --white:#fff; --red:#b91c1c; --red-soft:#fdeeee; --peach:#fdba74;
  --font:'Plus Jakarta Sans',system-ui,-apple-system,'Segoe UI',Roboto,Arial,sans-serif;
  --radius:14px; --radius-lg:18px;
  --shadow:0 10px 30px rgba(16,40,24,.08);
  --gutter-l:max(16px, env(safe-area-inset-left, 0px));
  --gutter-r:max(16px, env(safe-area-inset-right, 0px));
  color-scheme:light;
}

/* ---------- 2. Basis ---------- */
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{margin:0;font-family:var(--font);font-size:16px;line-height:1.6;color:var(--body);background:var(--white);-webkit-font-smoothing:antialiased;overflow-x:hidden}
h1,h2,h3,p,ul{margin:0}
ul{padding:0;list-style:none}
h1,h2,h3{color:var(--ink);line-height:1.2;font-weight:800;letter-spacing:-.01em;text-wrap:balance}
h1{font-size:30px}
h2{font-size:26px;margin-bottom:14px}
h3{font-size:18px}
p+p{margin-top:12px}
a{color:var(--green)}
img,svg{max-width:100%}
button{font:inherit;color:inherit}
[hidden]{display:none !important}
:focus-visible{outline:3px solid var(--orange);outline-offset:2px}
@media (prefers-reduced-motion:reduce){*{animation:none !important;transition:none !important;scroll-behavior:auto !important}}

.wrap{width:100%;max-width:1120px;margin:0 auto;padding-left:var(--gutter-l);padding-right:var(--gutter-r)}
.narrow{max-width:760px}
.eyebrow{font-size:12px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--green);margin-bottom:8px}
.lead{font-size:17px}
.center{text-align:center}

/* ---------- 3. Knoppen en invoer ---------- */
.btn{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;min-height:54px;padding:14px 22px;border:0;border-radius:12px;background:var(--orange);color:#fff;font-weight:700;font-size:17px;text-decoration:none;cursor:pointer;box-shadow:0 6px 16px rgba(234,88,12,.28);transition:background .15s,transform .1s;-webkit-tap-highlight-color:transparent}
.btn:hover{background:var(--orange-dark)}
.btn:active{transform:translateY(1px)}
.btn[disabled]{opacity:.6;cursor:default}
.input{display:block;width:100%;min-height:52px;padding:12px 14px;border:2px solid var(--line);border-radius:10px;background:#fff;color:var(--ink);font:inherit;font-size:17px;outline:none;-webkit-appearance:none;appearance:none}
.input:focus{border-color:var(--green)}
.input.is-pc{font-weight:700;letter-spacing:.05em;text-transform:uppercase;font-size:19px}
.input[disabled]{background:var(--bg);color:var(--muted)}
.micro{display:flex;flex-wrap:wrap;gap:4px 14px;margin-top:10px;font-size:13.5px;color:var(--muted)}
.micro span::before{content:"✓";color:var(--green);font-weight:800;margin-right:5px}

/* ---------- 4. Topbalk en header ---------- */
.topbar{background:var(--ink);color:#fff;font-size:13px;line-height:1.45;text-align:center;padding:8px var(--gutter-r) 8px var(--gutter-l)}
.topbar strong{color:var(--peach)}
.site-head{background:#fff;border-bottom:1px solid var(--line)}
.site-head .wrap{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:56px}
.logo{display:flex;align-items:center;gap:8px;text-decoration:none;font-weight:800;font-size:18px;color:var(--ink)}
.logo svg{flex:none;width:28px;height:28px}
.wm{color:var(--ink);letter-spacing:-.01em}
.wm span{color:var(--green)}
.hdr-note{display:none;font-size:14px;color:var(--muted)}
.secure{display:none;align-items:center;gap:6px;font-size:13px;color:var(--muted)}

/* ---------- 5. Hero ---------- */
.hero{position:relative;padding:32px 0 40px;color:#e8f5ec;background-color:var(--green-dark);
  --hero-img:url('data:image/jpeg;base64,');
  background-image:linear-gradient(90deg,rgba(10,66,32,.94) 0%,rgba(15,95,45,.88) 55%,rgba(21,128,61,.6) 100%),var(--hero-img);
  background-size:cover;background-position:22% center}
.hero-grid{display:grid;gap:24px}
.kicker{display:inline-flex;align-items:center;gap:8px;margin-bottom:16px;padding:6px 12px;border:1px solid rgba(255,255,255,.3);border-radius:99px;background:rgba(255,255,255,.14);color:#fff;font-size:13px;font-weight:700}
.kicker .dot{width:8px;height:8px;border-radius:50%;background:var(--orange);box-shadow:0 0 0 4px rgba(234,88,12,.2)}
.hero h1{color:#fff;margin-bottom:14px}
.hero h1 em{font-style:normal;color:var(--peach)}
.hero .sub{font-size:16.5px;margin-bottom:20px;color:#e8f5ec}
.hero .sub strong{color:#fff}

.pc-box{background:#fff;border-radius:var(--radius);padding:16px;box-shadow:var(--shadow);color:var(--body)}
.pc-box label{display:block;margin-bottom:8px;font-weight:700;font-size:15px;color:var(--ink)}
.pc-row{display:flex;flex-direction:column;gap:10px}
.pc-err{display:none;margin-top:8px;font-size:14px;color:var(--red)}
.pc-box.has-err .pc-err{display:block}
.pc-box.has-err .input{border-color:var(--red)}

.rate-card{background:rgba(255,255,255,.97);border-radius:var(--radius-lg);padding:16px;box-shadow:var(--shadow)}
.rates{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.rate{border-radius:12px;padding:12px;text-align:center}
.rate small{display:block;font-size:12.5px;font-weight:600}
.rate b{display:block;margin-top:2px;font-size:28px;font-weight:800;line-height:1.1}
.rate.now{background:var(--green);color:#fff}
.rate.later{background:#f1f3f2;color:var(--muted)}
.rate.later b{text-decoration:line-through;text-decoration-color:var(--red);text-decoration-thickness:3px}
.countdown{margin-top:12px;text-align:center;font-size:14px;color:var(--body)}
.countdown strong{color:var(--orange)}

/* ---------- 6. Secties ---------- */
.section{padding:44px 0}
.section.alt{background:var(--bg)}

.urgent{background:#fff;border-left:5px solid var(--orange);border-radius:var(--radius);box-shadow:var(--shadow);padding:22px 18px}
.urgent .hl{margin:16px 0;padding:14px 16px;border-radius:10px;background:var(--orange-soft);color:var(--ink);font-weight:600}
.urgent .close{margin-top:16px;font-size:17px;font-weight:800;color:var(--ink)}
.deadline-line{margin-top:14px;padding:12px 16px;border-radius:10px;background:var(--ink);color:#fff;font-weight:700}
.source{margin-top:16px;font-size:12.5px;color:var(--muted)}

.table-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch;margin-top:12px;border-radius:var(--radius);box-shadow:var(--shadow)}
.calc-table{width:100%;min-width:320px;border-collapse:separate;border-spacing:0;background:#fff;font-variant-numeric:tabular-nums}
.calc-table th,.calc-table td{padding:12px 10px;text-align:left;font-size:14.5px;border-bottom:1px solid var(--line);vertical-align:middle}
.calc-table thead th{font-size:13px;line-height:1.3}
.calc-table th.y26{background:var(--green);color:#fff}
.calc-table th.y27{background:#e9ecea;color:var(--muted)}
.calc-table td.y26{background:var(--green-soft);color:var(--green-dark);font-weight:800;font-size:16px}
.calc-table td.y27{color:var(--muted);font-weight:600}
.calc-table td.lbl{font-weight:600;color:var(--ink)}
.calc-table tr.miss td{background:var(--red-soft);border-bottom:0}
.calc-table tr.miss td.y27{color:var(--red);font-weight:800;font-size:17px}

.panel{margin-top:20px;padding:18px;border:1px solid var(--line);border-radius:var(--radius);background:#fff}
.panel h3{margin-bottom:4px}
.m2-label{margin-bottom:10px;font-size:15px;color:var(--muted)}
.range{width:100%;height:32px;accent-color:var(--green)}
.calc-out{display:grid;gap:8px;margin-top:12px;font-variant-numeric:tabular-nums}
.calc-out div{display:flex;align-items:baseline;justify-content:space-between;padding:10px 14px;border-radius:10px;background:#f4f6f5}
.calc-out small{font-size:13.5px;font-weight:600;color:var(--muted)}
.calc-out b{font-size:20px;color:var(--ink)}
.calc-out .g{background:var(--green-soft)} .calc-out .g b{color:var(--green-dark)}
.calc-out .r{background:var(--red-soft)} .calc-out .r b{color:var(--red)}
.fineprint{margin-top:12px;font-size:12.5px;color:var(--muted)}

.double{display:flex;gap:12px;align-items:flex-start;margin-top:20px;padding:16px;border:1px solid var(--green-line);border-radius:var(--radius);background:var(--green-soft)}
.double .ic{flex:none;display:grid;place-items:center;width:38px;height:38px;border-radius:10px;background:var(--green);color:#fff;font-weight:800}

.warn{position:relative;margin-top:30px;padding:24px 18px 20px;border:2px solid var(--orange);border-radius:var(--radius);background:#fff}
.warn .tag{position:absolute;top:-13px;left:16px;padding:3px 12px;border-radius:99px;background:var(--orange);color:#fff;font-size:12px;font-weight:800;letter-spacing:.03em}
.warn h3{margin-bottom:8px;font-size:19px}
.vs{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:14px 0 6px;font-variant-numeric:tabular-nums}
.vs div{padding:12px;border-radius:10px;text-align:center}
.vs .lo{background:#f1f3f2}
.vs .hi{background:var(--green);color:#fff}
.vs small{display:block;font-size:12.5px;font-weight:600;opacity:.85}
.vs b{font-size:22px}

.tiles{display:grid;gap:12px;margin:22px 0 34px}
.tile{display:flex;gap:14px;align-items:flex-start;padding:16px;border:1px solid var(--line);border-radius:var(--radius);background:#fff}
.tile .ti{flex:none;display:grid;place-items:center;width:42px;height:42px;border-radius:12px;background:var(--green-soft)}
.tile h3{font-size:16.5px;margin-bottom:2px}
.tile p{font-size:14.5px;color:var(--muted)}
.tile.hot{border-color:var(--orange);background:var(--orange-soft)}
.tile.hot .ti{background:#fff}

.h2-sub{font-size:24px}
.benefits{display:grid;gap:18px}
.benefit{display:flex;gap:14px}
.num{flex:none;display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:var(--green);color:#fff;font-weight:800}
.benefit h3{margin-bottom:2px}
.benefit p{font-size:15.5px}

.kader{margin-top:34px;padding:22px 18px;border-radius:var(--radius);background:var(--ink);color:#e5ece7}
.kader h3{margin-bottom:10px;color:#fff;font-size:20px}
.kader li{position:relative;padding:10px 0 10px 26px;border-bottom:1px solid rgba(255,255,255,.1)}
.kader li:last-child{border-bottom:0}
.kader li::before{content:"";position:absolute;left:0;top:17px;width:12px;height:12px;border-radius:3px;background:var(--orange)}
.kader b{color:#fff}

.conds li{display:flex;gap:12px;padding:14px 0;border-bottom:1px solid var(--line)}
.conds li:last-child{border-bottom:0}
.ck{flex:none;display:grid;place-items:center;width:28px;height:28px;border-radius:8px;background:var(--green-soft);color:var(--green);font-weight:800}
.help{margin-top:18px;padding:18px;border-radius:var(--radius);background:var(--green);color:#fff;font-weight:600}

.steps3{display:grid;gap:12px;margin:22px 0 28px}
.step3{display:flex;gap:14px;align-items:center;padding:16px;border:1px solid var(--line);border-radius:var(--radius);background:#fff}
.step3 .num{width:42px;height:42px;font-size:18px}
.step3 p{font-size:14.5px;color:var(--muted)}
.cta-box{max-width:640px;margin:0 auto;padding:22px 16px;border:1px solid var(--line);border-radius:var(--radius-lg);background:#fff;box-shadow:var(--shadow)}
.cta-box h2{font-size:24px;margin-bottom:8px}
.cta-box .pc-box{margin-top:16px;padding:0;box-shadow:none}

.faq-item{border-bottom:1px solid var(--line)}
.faq-q{position:relative;display:block;width:100%;min-height:56px;padding:16px 40px 16px 0;border:0;background:none;text-align:left;font-weight:700;font-size:16.5px;color:var(--ink);cursor:pointer}
.faq-q::after{content:"+";position:absolute;right:4px;top:12px;font-size:26px;font-weight:600;color:var(--green);transition:transform .2s}
.faq-item.open .faq-q::after{transform:rotate(45deg)}
.faq-a{display:none;padding:0 0 18px;font-size:15.5px}
.faq-item.open .faq-a{display:block}

.site-foot{padding:32px 0 calc(100px + env(safe-area-inset-bottom, 0px));background:var(--ink);color:#aab8ae;font-size:13.5px}
.foot-row{display:grid;gap:12px}
.foot-links{display:flex;flex-wrap:wrap;gap:6px 16px}
.site-foot a{color:#d6e2da;text-decoration:none}
.site-foot a:hover{text-decoration:underline}
.disc{margin-top:18px;font-size:12px;color:#8a998f}

.sticky{position:fixed;left:0;right:0;bottom:0;z-index:50;padding:10px var(--gutter-r) calc(10px + env(safe-area-inset-bottom, 0px)) var(--gutter-l);background:#fff;border-top:1px solid var(--line);box-shadow:0 -6px 18px rgba(0,0,0,.06);transform:translateY(110%);transition:transform .25s ease}
.sticky.show{transform:none}
.sticky small{display:block;margin-top:4px;text-align:center;font-size:12.5px;color:var(--muted)}

/* ---------- 7. Vragenflow ---------- */
.flow{min-height:100vh;background:var(--bg)}
.flow-main{width:100%;max-width:640px;margin:0 auto;padding:18px var(--gutter-r) 0 var(--gutter-l)}
.progress{margin-bottom:14px}
.progress-meta{display:flex;justify-content:space-between;margin-bottom:6px;font-size:13px;font-weight:600;color:var(--muted)}
.bar{height:8px;overflow:hidden;border-radius:99px;background:#dfe6e1}
.bar i{display:block;width:0;height:100%;border-radius:99px;background:var(--green);transition:width .35s ease}
.card{padding:22px 18px;border:1px solid var(--line);border-radius:var(--radius-lg);background:#fff;box-shadow:0 10px 30px rgba(16,40,24,.07)}
.q{display:none}
.q.active{display:block;animation:fadeUp .25s ease}
@keyframes fadeUp{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.q h1{font-size:22px;margin-bottom:6px}
.q .intro{margin-bottom:16px;font-size:15.5px}
.qnum{margin-bottom:6px;font-size:12px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--green)}
.opts{display:grid;gap:10px;margin-top:16px}
.opts + .opts{margin-top:10px}
.opt{display:flex;align-items:center;gap:12px;width:100%;min-height:54px;padding:12px 14px;border:2px solid var(--line);border-radius:12px;background:#fff;text-align:left;font-weight:600;color:var(--ink);cursor:pointer;transition:border-color .15s,background .15s;-webkit-tap-highlight-color:transparent}
.opt:hover{border-color:var(--green-line);background:#fbfdfb}
.opt .rd{position:relative;flex:none;width:22px;height:22px;border:2px solid #c3cdc6;border-radius:50%}
.opt.sel{border-color:var(--green);background:var(--green-soft)}
.opt.sel .rd{border-color:var(--green)}
.opt.sel .rd::after{content:"";position:absolute;inset:4px;border-radius:50%;background:var(--green)}
.opt.first{border-color:var(--orange-line)}
.opt.first.sel{border-color:var(--green)}
.badge{margin-left:auto;padding:2px 9px;border-radius:99px;background:var(--orange);color:#fff;font-size:12px;font-weight:800;white-space:nowrap}
.feedback{display:none;margin-top:12px;padding:12px 14px;border:1px solid var(--green-line);border-radius:12px;background:var(--green-soft);color:var(--green-dark);font-weight:600;font-size:15px}
.feedback.show{display:block}
.pc-banner{display:flex;align-items:center;gap:10px;margin-bottom:12px;padding:10px 12px;border:1px solid var(--green-line);border-radius:12px;font-size:14px}
.pc-banner b{color:var(--ink)}
.pc-banner button{margin-left:auto;padding:6px 4px;border:0;background:none;color:var(--green);font-weight:700;font-size:14px;cursor:pointer}
.note{margin-top:12px;padding:12px 14px;border-radius:12px;font-size:14.5px}
.note.info{border:1px solid var(--green-line);background:var(--green-soft);color:var(--green-dark)}
.note.warn{margin:0 0 12px;border:1px solid var(--orange-line);background:var(--orange-soft);color:#7c2d12}

.field{margin-top:14px}
.field label,.field .lbl{display:block;margin-bottom:6px;font-weight:700;font-size:14.5px;color:var(--ink)}
.field .e{display:none;margin-top:5px;font-size:13.5px;color:var(--red)}
.field.bad .e{display:block}
.field.bad .input{border-color:var(--red)}
.row2{display:grid;gap:0}
/* Postcode + huisnummer lookup (Asana subtask 1219806639155975): postcode on its own row on phones */
.row-adres{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:0 12px}
.row-adres > :first-child{grid-column:1/-1}
.addr-status{margin:-6px 0 14px;font-size:13.5px;color:var(--muted)}
.input.error{border-color:var(--red)}
.input.valid{border-color:var(--green)}
.seg{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.seg button{min-height:50px;border:2px solid var(--line);border-radius:10px;background:#fff;font-weight:600;color:var(--ink);cursor:pointer}
.seg button.sel{border-color:var(--green);background:var(--green-soft)}
.field.bad .seg button{border-color:var(--red)}
.check{display:flex;gap:12px;align-items:flex-start;margin-top:16px;font-size:14px;cursor:pointer}
.check input{flex:none;width:24px;height:24px;margin:0;accent-color:var(--green)}
.check.bad{color:var(--red)}
.q .btn{margin-top:18px}
.q .micro{justify-content:center}

.done-icon{display:grid;place-items:center;width:60px;height:60px;margin:0 auto 14px;border-radius:50%;background:var(--green)}
.q h1.center{text-align:center}
.prep{margin-top:16px;padding:14px 16px;border-radius:12px;background:var(--bg)}
.prep ul{margin-top:6px;padding-left:20px;list-style:disc}
.alert{margin-top:16px;padding:12px 14px;border-left:5px solid var(--orange);border-radius:10px;background:var(--orange-soft);color:#7c2d12;font-weight:700}
.next{margin-top:24px;padding-top:20px;border-top:1px solid var(--line)}
.next h2{margin-bottom:2px;font-size:19px}
.nextsteps{margin-top:10px}
.nextsteps li{display:flex;gap:12px;padding:10px 0;border-bottom:1px solid var(--line)}
.nextsteps li:last-child{border-bottom:0}
.nextsteps .num{width:30px;height:30px;font-size:15px}
.linkbtn{display:inline-flex;align-items:center;gap:6px;min-height:44px;margin-top:12px;padding:4px 0;border:0;background:none;color:var(--muted);font-size:15px;cursor:pointer}
.linkbtn:hover{color:var(--ink)}
.flow-foot{max-width:640px;margin:0 auto;padding:14px var(--gutter-r) calc(28px + env(safe-area-inset-bottom, 0px)) var(--gutter-l);text-align:center;font-size:12.5px;color:var(--muted)}
.flow-foot a{margin:0 5px;color:var(--muted)}

/* ---------- 8. Breakpoint sm: vanaf 640px ---------- */
@media (min-width:640px){
  body{font-size:17px}
  h1{font-size:38px}
  h2{font-size:30px}
  .hdr-note,.secure{display:flex}
  .btn{width:auto;font-size:18px;padding:15px 26px}
  .pc-row{flex-direction:row}
  .pc-row .input{flex:1;min-width:0}
  .pc-box{padding:18px}
  .hero{padding:48px 0 56px}
  .hero .sub{font-size:18px}
  .section{padding:56px 0}
  .urgent{padding:30px 32px}
  .calc-table th,.calc-table td{padding:15px 18px;font-size:16.5px}
  .calc-table thead th{font-size:14.5px}
  .calc-table td.y26{font-size:18px}
  .calc-out{grid-template-columns:repeat(3,1fr)}
  .calc-out div{flex-direction:column;align-items:center;text-align:center}
  .panel,.double{padding:22px}
  .warn{padding:26px 26px 22px}
  .vs b{font-size:26px}
  .tiles{grid-template-columns:1fr 1fr}
  .tile{flex-direction:column}
  .steps3{grid-template-columns:repeat(3,1fr)}
