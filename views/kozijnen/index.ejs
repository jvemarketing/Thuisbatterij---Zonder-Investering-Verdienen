        <div class="field" id="f-aanhef">
          <span class="lbl" id="aanhefLbl">Aanhef</span>
          <div class="seg" id="aanhef" role="group" aria-labelledby="aanhefLbl"><button type="button" data-v="Dhr.">Dhr.</button><button type="button" data-v="Mevr.">Mevr.</button><button type="button" data-v="Anders">Anders</button></div>
          <div class="e">Kies een aanhef.</div>
        </div>
        <div class="row2">
          <div class="field" id="f-voornaam"><label for="voornaam">Voornaam</label><input class="input" id="voornaam" autocomplete="given-name"><div class="e">Vul je voornaam in.</div></div>
          <div class="field" id="f-achternaam"><label for="achternaam">Achternaam</label><input class="input" id="achternaam" autocomplete="family-name"><div class="e">Vul je achternaam in.</div></div>
        </div>
        <div class="row-adres">
          <div class="field" id="f-postcode"><label for="postcode">Postcode</label><input class="input" id="postcode" autocomplete="postal-code" maxlength="7" placeholder="1234 AB"><div class="e">Vul een geldige postcode in.</div></div>
          <div class="field" id="f-huisnr"><label for="huisnr">Huisnummer</label><input class="input" id="huisnr" inputmode="numeric" placeholder="12"><div class="e">Vul je huisnummer in.</div></div>
          <div class="field"><label for="toevoeging">Toevoeging</label><input class="input" id="toevoeging" placeholder="A"></div>
        </div>
        <div class="addr-status" id="addrStatus">Vul je postcode en huisnummer in, dan vullen we je adres automatisch aan.</div>
        <div class="row2">
          <div class="field" id="f-straat"><label for="straat">Straatnaam</label><input class="input" id="straat" autocomplete="address-line1"><div class="e">Vul je straatnaam in.</div></div>
          <div class="field" id="f-plaats"><label for="plaats">Plaats</label><input class="input" id="plaats" autocomplete="address-level2"><div class="e">Vul je plaats in.</div></div>
