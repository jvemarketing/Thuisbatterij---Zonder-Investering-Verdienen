<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Afmelden Nieuwsbrief</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css"
          integrity="sha384-xOaLAA0Y5uU6sHhXw2L/9Q+gHjF4x5qA+5fF5+T9X0lE8z2+x2+Q+Gz5uL6F5F5t5t5t"
          crossorigin="anonymous">

    <style>
        body.background-image {
            background-size: cover;
            background-repeat: no-repeat;
            background-attachment: fixed;
            background-position: center center;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            font-family: 'Inter Tight', sans-serif;
            color: #333;
        }

        .unsubscribe-card {
            background-color: rgba(255, 255, 255, 0.95);
            border-radius: 10px;
            padding: 40px;
            box-shadow: 0 0 25px rgba(0, 0, 0, 0.15);
            max-width: 550px;
            width: 100%;
        }

        .logo-image {
            max-width: 180px;
            height: auto;
            margin-bottom: 24px;
            display: block;
        }

        h1 {
            font-size: 2.5rem;
            font-weight: 700;
            color: #212529;
            margin-bottom: -12px;
            text-align: left;
        }

        .card-text {
            font-size: 1.1rem;
            font-weight: 400;
            line-height: 1.5;
            margin-bottom: 32px;
            text-align: left;
        }

        .card-text strong {
            font-weight: 600;
            display: block;
            margin-bottom: 24px;
        }

        .input-label {
            font-weight: 400;
            display: block;
            margin-bottom: 8px;
            font-size: 1rem;
            text-align: left;
        }

        .form-control {
            border-radius: 5px;
            padding: 16px;
            font-size: 1rem;
            height: auto;
            border: 1px solid #ced4da;
            margin-bottom: 24px;
            width: 100%;
            font-family: 'Inter Tight', sans-serif;
            box-sizing: border-box;
        }

        hr {
            border-top: 1px solid #fafafa;
            margin-top: 32px;
            margin-bottom: 32px;
        }

        .btn-unsubscribe {
            background-color: <%= accentColor %>;
            border-color: <%= accentColor %>;
            color: <%= accentTextColor %>;
            padding: 16px 24px;
            font-size: 1.2rem;
            font-weight: 600;
            border-radius: 5px;
            width: 100%;
            margin-top: 16px;
            transition: background-color 0.3s ease, border-color 0.3s ease;
        }

        .btn-unsubscribe:hover {
            background-color: <%= accentColorHover %>;
            border-color: <%= accentColorHover %>;
            color: <%= accentTextColor %>;
        }

        .text-small {
            font-size: 0.9rem;
            text-align: left;
        }
    </style>
</head>
<body class="background-image">

<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"
        crossorigin="anonymous"></script>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-12">


            <div class="unsubscribe-card mx-auto">

                <img src="<%= logo.src %>"
                     alt="<%= logo.alt %>" class="logo-image">

                <h1>Afmelden</h1>

                <p class="card-text" style="margin-bottom: 16px;">
                    Bevestig de gegevens die u wenst af te melden.
                </p>

                <form id="optOutForm">

                    <div class="form-group mb-0">
                        <label for="emailInput" class="input-label">Voer e-mailadres in:</label>
                        <input type="email" class="form-control" id="emailInput" name="email"
                               placeholder="your-email@email.com" aria-describedby="emailHelp">
                    </div>

                    <div class="form-group mb-0">
                        <label for="mobileInput" class="input-label">Vul mobiel nummer in:</label>
                        <input type="tel" class="form-control" id="mobileInput" name="mobile" placeholder="0612345678"
                               aria-describedby="mobileHelp">
                    </div>

                    <button type="submit" class="btn btn-unsubscribe" id="submitBtn">
                        Uitschrijven
                    </button>

                    <div id="optOutError" style="display:none;color:#c0392b;margin-top:12px;font-size:.95rem;"></div>

                </form>

                <div id="optOutSuccess" style="display:none;text-align:center;padding:16px 0">
                    <p style="font-size:1.5rem;font-weight:700;color:#212529;margin-bottom:8px">&#10003; Afgemeld</p>
                    <p style="color:#555;font-size:1rem;">Uw gegevens zijn verwijderd uit onze database.</p>
                </div>

                <script>
                    document.getElementById('optOutForm').addEventListener('submit', async function(e) {
                        e.preventDefault();
                        const btn = document.getElementById('submitBtn');
                        const errEl = document.getElementById('optOutError');
                        errEl.style.display = 'none';
                        btn.disabled = true;
                        btn.textContent = 'Bezig...';
                        try {
                            const res = await fetch('/api/opt-out', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    email: document.getElementById('emailInput').value,
                                    mobile: document.getElementById('mobileInput').value,
                                }),
                            });
                            if (!res.ok) {
                                const data = await res.json();
                                throw new Error(data.error || 'Er is een fout opgetreden.');
                            }
                            document.getElementById('optOutForm').style.display = 'none';
                            document.getElementById('optOutSuccess').style.display = 'block';
                        } catch (err) {
                            errEl.textContent = err.message;
                            errEl.style.display = 'block';
                            btn.disabled = false;
                            btn.textContent = 'Uitschrijven';
                        }
                    });
                </script>

                <hr>

                <p class="text-muted text-small">
                    Heeft u vragen? Stuur een mailtje naar
                    <a href="mailto:<%= companyEmail %>"><%= companyEmail %></a>
                </p>
            </div>
        </div>
    </div>
</div>
</body>
</html>
