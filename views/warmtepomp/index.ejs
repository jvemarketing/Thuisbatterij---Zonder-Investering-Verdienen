</head><body>
<title>VerdienDuurzaam Warmtepomp</title>
<meta name="description" content="Vanaf 2029 wil de regering een hybride warmtepomp bij vervanging van uw cv-ketel. Check gratis of uw woning geschikt is, inclusief subsidiecheck op uw postcode.">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800;900&family=Figtree:wght@400;500;600;700&display=swap">
<style>
/* Merkpagina met één vaste (lichte) look: kleuren expliciet uit de VerdienDuurzaam tokens */
/* VerdienDuurzaam design tokens, gegenereerd uit tokens.json */
:root {
  --background: oklch(96.8% 0.014 88.5);
  --foreground: oklch(23.5% 0.028 158);
  --card: oklch(99.5% 0.003 90);
  --card-foreground: oklch(23.5% 0.028 158);
  --popover: oklch(99.5% 0.003 90);
  --popover-foreground: oklch(23.5% 0.028 158);
  --primary: oklch(50.5% 0.114 162);
  --primary-foreground: oklch(99% 0.004 90);
  --primary-soft: oklch(94% 0.033 158);
  --secondary: oklch(94.5% 0.016 88);
  --secondary-foreground: oklch(23.5% 0.028 158);
  --muted: oklch(94.5% 0.014 88);
  --muted-foreground: oklch(49% 0.017 158);
  --accent: oklch(72% 0.198 48);
  --accent-hover: oklch(67% 0.196 46);
  --accent-foreground: oklch(99.5% 0.005 90);
  --warm: oklch(79% 0.14 62);
  --cool: oklch(72% 0.09 232);
  --navy: oklch(27% 0.055 252);
  --navy-foreground: oklch(97% 0.008 240);
  --success: oklch(72% 0.17 155);
  --destructive: oklch(57.7% 0.245 27.325);
  --destructive-foreground: oklch(99% 0.004 90);
  --border: oklch(90% 0.012 100);
  --input: oklch(90% 0.012 100);
  --ring: oklch(50.5% 0.114 162);
  --spacing: 0.25rem;
  --page-gutter: 20px;
  --page-max: 76rem;
  --header-height: 64px;
  --card-pad: 20px;
  --panel-pad: 28px;
  --grid-gap: 16px;
  --section-gap: 48px;
  --radius: 16px;
  --radius-xl: 22px;
  --radius-2xl: 28px;
  --radius-3xl: 36px;
  --radius-4xl: 44px;
  --radius-full: 9999px;
  --shadow-card: 0 1px 2px oklch(24% 0.03 160 / 0.05), 0 12px 32px -18px oklch(24% 0.03 160 / 0.22);
  --shadow-panel: 0 2px 4px oklch(24% 0.03 160 / 0.06), 0 28px 60px -28px oklch(24% 0.03 160 / 0.28);
  --shadow-cta: 0 10px 24px -10px oklch(72% 0.198 48);
  --font-display: "Archivo", ui-sans-serif, system-ui, sans-serif;
  --font-sans: "Figtree", ui-sans-serif, system-ui, sans-serif;
}
:root{color-scheme:light}
/* VerdienDuurzaam: hybride warmtepomp landingspagina. Bouwt op css/tokens.css */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;border:0 solid}
html{-webkit-text-size-adjust:100%;line-height:1.5;scroll-behavior:smooth}
body{background:var(--background);color:var(--foreground);font-family:var(--font-sans);-webkit-font-smoothing:antialiased}
img,svg{display:block;max-width:100%}
a{color:inherit;text-decoration:inherit}
button,input,select{font:inherit;color:inherit;background:none}
button{cursor:pointer}
h1,h2,h3,h4{font-family:var(--font-display);letter-spacing:-.025em;text-wrap:balance;font-weight:800}
.ic{width:20px;height:20px;flex-shrink:0;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.ic-sm{width:16px;height:16px}
.ic-xs{width:14px;height:14px}
.star{fill:currentColor}

.container-page{width:100%;max-width:var(--page-max);margin-inline:auto;padding-inline:var(--page-gutter)}
.section{padding-block:40px 24px}
@media (min-width:640px){.section{padding-block:56px 32px}}
.h2{font-size:24px;line-height:32px;max-width:42rem}
@media (min-width:640px){.h2{font-size:30px;line-height:36px}}
.lead{margin-top:12px;max-width:42rem;font-size:14px;line-height:1.625;color:var(--muted-foreground)}
@media (min-width:640px){.lead{font-size:16px}}
.muted{color:var(--muted-foreground)}

/* header */
.site-header{position:sticky;top:env(safe-area-inset-top,0px);z-index:40;border-bottom:1px solid color-mix(in oklab,var(--border) 70%,transparent);background:color-mix(in oklab,var(--background) 85%,transparent);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px)}
.site-header .container-page{display:flex;height:var(--header-height);align-items:center;justify-content:space-between;gap:16px}
.logo{height:24px;width:auto}
@media (min-width:640px){.site-header .logo{height:28px}}
.header-cta{display:none;font-size:13px;font-weight:700;color:var(--primary)}
@media (min-width:640px){.header-cta{display:inline-flex;align-items:center;gap:6px}}

/* buttons */
.btn{display:inline-flex;width:100%;align-items:center;justify-content:center;gap:8px;border-radius:var(--radius-2xl);background:var(--accent);padding:16px 24px;text-align:center;font-size:16px;line-height:24px;font-weight:800;letter-spacing:.025em;color:var(--accent-foreground);box-shadow:var(--shadow-cta);transition:background-color .15s cubic-bezier(.4,0,.2,1)}
.btn:hover{background:var(--accent-hover)}
.btn:focus-visible{outline:3px solid var(--primary);outline-offset:3px}
@media (min-width:640px){.btn{width:auto}}
.btn-block{width:100% !important;text-transform:uppercase}
.cta-row{margin-top:28px}
.micro{margin-top:12px;font-size:12px;line-height:1.375;color:var(--muted-foreground)}

/* hero */
.hero{position:relative;overflow:hidden;background:var(--background)}
.hero-grid{display:grid;gap:24px;padding-block:32px 24px;align-items:start}
@media (min-width:1024px){.hero-grid{grid-template-columns:1.1fr .9fr;gap:48px;padding-block:48px 40px;align-items:center}}
.badge{display:inline-flex;align-items:center;gap:8px;border-radius:9999px;background:var(--accent);padding:6px 14px;font-size:12px;line-height:16px;font-weight:700;color:var(--accent-foreground)}
.hero h1{margin-top:16px;font-size:1.95rem;line-height:1.08}
@media (min-width:640px){.hero h1{font-size:36px}}
@media (min-width:1024px){.hero h1{font-size:48px}}
.hero h1 .accent{display:block;color:var(--accent)}
.hero .sub{margin-top:16px;max-width:36rem;font-size:15px;line-height:1.625}
@media (min-width:640px){.hero .sub{font-size:16px}}
.trust{margin-top:24px;display:flex;flex-wrap:wrap;gap:8px}
.trust-item{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--border);border-radius:9999px;background:var(--card);padding:6px 14px;font-size:12px;font-weight:700;color:var(--foreground)}
.trust-item .ic{color:var(--primary)}
.stars{display:flex;color:var(--accent)}

/* funnel */
.panel{scroll-margin-top:96px;border:1px solid var(--border);border-radius:var(--radius-3xl);background:var(--card);padding:20px;box-shadow:var(--shadow-panel);transition:box-shadow .3s}
@media (min-width:640px){.panel{padding:28px}}
.panel.flash{box-shadow:var(--shadow-panel),0 0 0 4px color-mix(in oklab,var(--accent) 45%,transparent)}
.panel-title{font-size:20px;line-height:28px;color:var(--primary)}
@media (min-width:640px){.panel-title{font-size:24px;line-height:32px}}
.progress{margin-top:20px;display:flex;align-items:center;gap:12px}
.progress-track{height:8px;flex:1;overflow:hidden;border-radius:9999px;background:var(--muted)}
.progress-bar{height:100%;border-radius:9999px;background:var(--primary);transition:width .3s}
.progress-label{flex-shrink:0;font-size:12px;font-weight:600;color:var(--muted-foreground)}
.step{margin-top:24px}
.step h3{font-size:18px;line-height:28px;font-weight:700;color:var(--primary)}
@media (min-width:640px){.step h3{font-size:20px}}
.step-help{margin-top:6px;font-size:14px;color:var(--muted-foreground)}
.options{margin-top:16px;display:grid;gap:8px}
.options.two{grid-template-columns:1fr 1fr}
.opt{display:flex;min-height:48px;width:100%;align-items:center;gap:12px;border:1px solid var(--input);border-radius:var(--radius-xl);background:var(--background);padding:10px 14px;text-align:left;font-size:15px;font-weight:600;transition:border-color .15s,background-color .15s}
.opt:hover{border-color:var(--primary)}
.opt:focus-visible{outline:2px solid var(--primary);outline-offset:2px}
.opt[aria-pressed="true"]{border-color:var(--primary);background:var(--primary-soft);color:var(--primary)}
.opt .dot{width:18px;height:18px;flex-shrink:0;border:2px solid var(--input);border-radius:9999px;display:grid;place-items:center}
.opt[aria-pressed="true"] .dot{border-color:var(--primary)}
.opt[aria-pressed="true"] .dot::after{content:"";width:8px;height:8px;border-radius:9999px;background:var(--primary)}
.fields{margin-top:16px;display:grid;gap:12px}
.fields.row{grid-template-columns:1fr 1fr}
.field span{margin-bottom:6px;display:block;font-size:12px;font-weight:600;color:var(--muted-foreground)}
.field input{height:48px;width:100%;border:1px solid var(--input);border-radius:var(--radius-xl);background:var(--background);padding:0 14px;font-size:15px;outline:none;transition:border-color .15s,box-shadow .15s}
.field input:focus{border-color:var(--primary);box-shadow:0 0 0 2px color-mix(in oklab,var(--ring) 25%,transparent)}
.field input[aria-invalid="true"]{border-color:var(--destructive)}
.err{margin-top:10px;font-size:13px;font-weight:600;color:var(--destructive)}
.consent{margin-top:16px;display:flex;gap:10px;align-items:flex-start;font-size:12px;line-height:1.5;color:var(--muted-foreground)}
.consent input{margin-top:2px;width:18px;height:18px;flex-shrink:0;accent-color:var(--primary)}
.consent a{text-decoration:underline;color:var(--foreground)}
.step-nav{margin-top:20px;display:flex;flex-direction:column;gap:12px}
.back{display:inline-flex;align-items:center;gap:4px;align-self:flex-start;font-size:13px;font-weight:600;color:var(--muted-foreground)}
.back:hover{color:var(--foreground)}
.notice{margin-top:16px;border-radius:var(--radius-xl);background:var(--secondary);padding:14px;font-size:14px;line-height:1.5}
.privacy{margin-top:16px;text-align:center;font-size:12px;color:var(--muted-foreground)}

/* statements band */
.band{background:var(--primary-soft)}
.band-grid{display:grid;gap:12px;padding-block:24px}
@media (min-width:640px){.band-grid{grid-template-columns:1fr 1fr}}
@media (min-width:1024px){.band-grid{grid-template-columns:repeat(5,1fr);gap:20px;padding-block:32px}}
.statement{display:flex;gap:10px;font-size:14px;line-height:1.5;color:var(--foreground)}
.statement .ic{margin-top:2px;color:var(--primary)}
.statement b{font-weight:800;color:var(--primary)}

/* stats */
.stats{margin-top:24px;display:grid;gap:12px}
@media (min-width:768px){.stats{grid-template-columns:repeat(3,1fr);gap:16px}}
.stat{border:1px solid var(--border);border-radius:var(--radius-2xl);background:var(--card);padding:20px;box-shadow:var(--shadow-card)}
.stat-num{display:block;font-family:var(--font-display);font-size:36px;line-height:40px;font-weight:900;letter-spacing:-.025em;color:var(--primary)}
.stat-label{margin-top:4px;display:block;font-size:16px;font-weight:800}
.stat p{margin-top:8px;font-size:14px;line-height:1.625;color:var(--muted-foreground)}

/* benefit blocks */
.blocks{margin-top:24px;display:grid;gap:16px}
@media (min-width:640px){.blocks{grid-template-columns:1fr 1fr}}
@media (min-width:1024px){.blocks{grid-template-columns:repeat(3,1fr)}}
.block{display:flex;gap:14px;border:1px solid var(--border);border-radius:var(--radius-3xl);background:var(--card);padding:20px}
.tile{display:inline-flex;width:36px;height:36px;flex-shrink:0;align-items:center;justify-content:center;border-radius:var(--radius-xl);background:var(--primary-soft);color:var(--primary)}
.block h3{font-size:16px;line-height:24px;font-weight:700}
.block p{margin-top:4px;font-size:14px;line-height:1.625;color:var(--muted-foreground)}

/* urgency */
.dark{border-radius:var(--radius-4xl);background:var(--foreground);color:var(--background);padding:40px 20px}
@media (min-width:640px){.dark{padding:56px 48px}}
.dark .h2{color:var(--background)}
.dark .body{margin-top:12px;max-width:44rem;font-size:15px;line-height:1.625;color:color-mix(in oklab,var(--background) 75%,transparent)}
.reasons{margin-top:28px;display:grid;gap:16px;counter-reset:r}
@media (min-width:768px){.reasons{grid-template-columns:repeat(3,1fr)}}
.reason{border-radius:var(--radius-2xl);background:color-mix(in oklab,var(--background) 8%,transparent);border:1px solid color-mix(in oklab,var(--background) 15%,transparent);padding:20px}
.reason .n{display:inline-flex;width:32px;height:32px;align-items:center;justify-content:center;border-radius:9999px;background:var(--accent);font-weight:900;font-family:var(--font-display);color:var(--accent-foreground)}
.reason h3{margin-top:12px;font-size:17px;line-height:24px;color:var(--background)}
.reason p{margin-top:6px;font-size:14px;line-height:1.625;color:color-mix(in oklab,var(--background) 70%,transparent)}
.dark .punch{margin-top:16px;font-family:var(--font-display);font-size:20px;line-height:28px;font-weight:800;letter-spacing:-.025em;color:var(--background)}
.callout{margin-top:28px;border-radius:var(--radius-3xl);background:linear-gradient(180deg,color-mix(in oklab,var(--warm) 20%,var(--card)),var(--card));color:var(--foreground);padding:20px;display:flex;gap:14px;font-size:15px;line-height:1.6}
.callout .tile{background:color-mix(in oklab,var(--warm) 35%,var(--card));color:var(--foreground)}
.callout b{font-weight:800}
.timeline{margin-top:32px;display:grid;gap:0;position:relative}
@media (min-width:768px){.timeline{grid-template-columns:repeat(3,1fr)}}
.tl{position:relative;padding:0 0 24px 32px}
@media (min-width:768px){.tl{padding:32px 16px 0 0}}
.tl::before{content:"";position:absolute;left:7px;top:4px;bottom:0;width:2px;background:color-mix(in oklab,var(--background) 20%,transparent)}
@media (min-width:768px){.tl::before{left:0;right:0;top:7px;bottom:auto;width:auto;height:2px}}
.tl:last-child::before{display:none}
@media (min-width:768px){.tl:last-child::before{display:block;right:50%}}
.tl .pin{position:absolute;left:0;top:0;width:16px;height:16px;border-radius:9999px;background:var(--background);border:3px solid var(--foreground);box-shadow:0 0 0 2px var(--background)}
.tl.now .pin{background:var(--success)}
.tl.mid .pin{background:var(--accent)}
.tl .when{display:block;font-size:11px;font-weight:900;letter-spacing:.2em;text-transform:uppercase;color:color-mix(in oklab,var(--background) 60%,transparent)}
.tl.now .when{color:var(--success)}
.tl .what{margin-top:4px;display:block;font-size:15px;font-weight:700;line-height:1.4;color:var(--background)}

/* subsidie */
.sub-grid{margin-top:24px;display:grid;gap:24px}
@media (min-width:1024px){.sub-grid{grid-template-columns:1fr 1fr;gap:48px;align-items:start}}
.prose p{font-size:15px;line-height:1.7;color:var(--foreground)}
.prose p+p{margin-top:14px}
.prose .muted{color:var(--muted-foreground)}
.table-card{border:1px solid var(--border);border-radius:var(--radius-3xl);background:var(--card);padding:8px;box-shadow:var(--shadow-card);overflow:hidden}
.cmp{width:100%;border-collapse:separate;border-spacing:0;font-size:15px}
.cmp th,.cmp td{padding:14px 12px;text-align:left}
.cmp thead th{font-family:var(--font-display);font-size:16px;font-weight:800;letter-spacing:-.025em}
.cmp thead th small{display:block;font-family:var(--font-sans);font-size:12px;font-weight:600;letter-spacing:0;color:var(--muted-foreground)}
.cmp .now{background:var(--primary-soft);color:var(--primary)}
.cmp thead .now{border-radius:var(--radius-xl) var(--radius-xl) 0 0}
.cmp tbody tr:last-child .now{border-radius:0 0 var(--radius-xl) var(--radius-xl)}
.cmp tbody th{font-weight:600;color:var(--muted-foreground);font-size:14px}
.cmp tbody td{font-family:var(--font-display);font-size:22px;font-weight:800;letter-spacing:-.025em}
.cmp tbody tr+tr th,.cmp tbody tr+tr td:not(.now){border-top:1px solid var(--border)}
.table-note{padding:10px 12px 8px;font-size:12px;line-height:1.5;color:var(--muted-foreground)}

/* steps */
.steps{margin-top:24px;display:grid;gap:16px}
@media (min-width:768px){.steps{grid-template-columns:repeat(3,1fr)}}
.stepcard{border:1px solid var(--border);border-radius:var(--radius-3xl);background:var(--card);padding:20px;box-shadow:var(--shadow-card)}
.stepcard .n{display:inline-flex;width:36px;height:36px;align-items:center;justify-content:center;border-radius:var(--radius-xl);background:var(--primary);font-family:var(--font-display);font-weight:900;color:var(--primary-foreground)}
.stepcard h3{margin-top:14px;font-size:16px;line-height:24px;font-weight:700}
.stepcard p{margin-top:4px;font-size:14px;line-height:1.625;color:var(--muted-foreground)}

/* reviews */
.rev-head{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:16px}
.pill{display:inline-flex;align-items:center;gap:8px;border-radius:9999px;background:var(--card);padding:6px 14px;font-size:12px;font-weight:700;color:var(--primary)}
.theme-line{margin-top:12px;max-width:42rem;font-size:15px;line-height:1.6;color:var(--muted-foreground)}
.theme-line q{font-weight:700;color:var(--foreground)}
.reviews{margin-top:24px;display:grid;gap:16px}
@media (min-width:640px){.reviews{grid-template-columns:repeat(3,1fr)}}
.review{display:flex;flex-direction:column;border:1px solid var(--border);border-radius:var(--radius-3xl);background:var(--card);padding:20px}
.review blockquote{margin-top:12px;flex:1;font-size:14px;line-height:1.625}
.review figcaption{margin-top:16px;border-top:1px solid var(--border);padding-top:12px}
.review figcaption b{display:block;font-size:14px;font-weight:800}
.review figcaption span{display:block;font-size:12px;color:var(--muted-foreground)}

/* final */
.final{border-radius:var(--radius-4xl);background:var(--foreground);padding:40px 20px;text-align:center}
@media (min-width:640px){.final{padding:48px}}
.final h2{margin-inline:auto;max-width:42rem;font-size:24px;line-height:32px;color:var(--background)}
@media (min-width:640px){.final h2{font-size:36px;line-height:40px}}
.final p{margin:12px auto 0;max-width:36rem;font-size:15px;color:color-mix(in oklab,var(--background) 75%,transparent)}
.final .micro{color:color-mix(in oklab,var(--background) 60%,transparent)}

/* footer */
.site-footer{margin-top:56px;border-top:1px solid var(--border);background:var(--card)}
.foot{display:flex;flex-direction:column;gap:24px;padding-block:40px}
@media (min-width:640px){.foot{flex-direction:row;justify-content:space-between;align-items:flex-start}}
.foot-info{max-width:28rem;display:grid;gap:12px;font-size:14px;color:var(--muted-foreground)}
.foot-links{display:flex;flex-direction:column;gap:8px;font-size:14px;color:var(--muted-foreground)}
.foot-links b{font-weight:600;color:var(--foreground)}
.foot-links a:hover{color:var(--foreground)}
.foot-legal{border-top:1px solid var(--border);padding-block:20px;font-size:12px;line-height:1.6;color:var(--muted-foreground)}

/* thank you */
.thanks{display:none;padding-block:56px 40px}
body.done main{display:none}
body.done .thanks{display:block}
.thanks-card{margin-inline:auto;max-width:40rem;border:1px solid var(--border);border-radius:var(--radius-3xl);background:var(--card);padding:28px;box-shadow:var(--shadow-panel);text-align:center}
.thanks-card .tile{width:56px;height:56px;border-radius:var(--radius-2xl)}
.thanks-card .tile .ic{width:28px;height:28px}
.thanks-card h1{margin-top:20px;font-size:30px;line-height:36px}
@media (min-width:640px){.thanks-card h1{font-size:40px;line-height:44px}}
.thanks-card p{margin-top:12px;font-size:16px;line-height:1.625;color:var(--muted-foreground)}
