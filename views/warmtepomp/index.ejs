  if(s.consent)h+='<label class="consent"><input type="checkbox" name="toestemming"'+(data.toestemming?' checked':'')+'><span>Ik ga akkoord dat VerdienDuurzaam mijn gegevens deelt met installateurs uit mijn regio, zodat zij mij kunnen bellen met een aanbod. <a href="/privacy.html" target="_blank" rel="noopener">Privacyverklaring</a></span></label>';
  h+='<p class="err" id="err" hidden></p><div class="step-nav">';
  if(s.cta)h+='<button type="button" class="btn btn-block" data-next>'+esc(s.cta)+arrow()+'</button>';
  if(i>0)h+='<button type="button" class="back" data-back><svg class="ic ic-sm"><use href="#i-back"/></svg>Vorige vraag</button>';
  h+='</div></div>';
  box.innerHTML=h;
  bar.style.width=Math.max(6,i/STEPS.length*100)+'%';
  lbl.textContent='Stap '+(i+1)+' van '+STEPS.length;
 }
 function err(m,el){var e=document.getElementById('err');e.textContent=m;e.hidden=false;if(el){el.setAttribute('aria-invalid','true');el.focus()}}
 function next(){i++;render();var f=box.querySelector('.opt,input');if(f&&document.activeElement&&box.contains(document.activeElement))f.focus()}
 box.addEventListener('click',function(e){
  var b=e.target.closest('.opt');
  if(b){var s=STEPS[i];data[s.k]=b.getAttribute('data-v');
   if(s.k==='eigenaar'&&data[s.k]==='Nee'){box.innerHTML='<div class="step"><div class="notice">Helaas, de subsidie en het aanbod gelden alleen voor huiseigenaren.</div><div class="step-nav"><button type="button" class="back" data-back><svg class="ic ic-sm"><use href="#i-back"/></svg>Vorige vraag</button></div></div>';i=1;return}
   box.querySelectorAll('.opt').forEach(function(x){x.setAttribute('aria-pressed',x===b)});setTimeout(next,180);return}
  if(e.target.closest('[data-back]')){i=Math.max(0,i-1);render();return}
  if(e.target.closest('[data-next]'))submit();
 });
 box.addEventListener('keydown',function(e){if(e.key==='Enter'&&e.target.tagName==='INPUT'&&e.target.type!=='checkbox'){e.preventDefault();submit()}});
 document.getElementById('funnel').addEventListener('submit',function(e){e.preventDefault();submit()});
 function submit(){
  var s=STEPS[i];if(!s.fields)return;
  var ok=true;s.fields.forEach(function(f){var el=box.querySelector('[name='+f[0]+']');data[f[0]]=el.value.trim();el.removeAttribute('aria-invalid')});
  if(s.k==='adres'){
   var pc=data.postcode.replace(/\s+/g,'').toUpperCase();
   if(!/^[1-9][0-9]{3}[A-Z]{2}$/.test(pc))return err('Vul een geldige postcode in, bijvoorbeeld 1234 AB.',box.querySelector('[name=postcode]'));
   data.postcode=pc.slice(0,4)+' '+pc.slice(4);
   if(!/[0-9]/.test(data.huisnummer))return err('Vul uw huisnummer in.',box.querySelector('[name=huisnummer]'));
   return next();
  }
  if(!data.voornaam)return err('Vul uw voornaam in.',box.querySelector('[name=voornaam]'));
  if(!data.achternaam)return err('Vul uw achternaam in.',box.querySelector('[name=achternaam]'));
  if(!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(data.email))return err('Vul een geldig e-mailadres in.',box.querySelector('[name=email]'));
  var tel=data.telefoon.replace(/[\s\-()]/g,'');
  if(!/^(0[1-9][0-9]{8}|(\+|00)31[1-9][0-9]{8})$/.test(tel))return err('Vul een geldig Nederlands telefoonnummer in.',box.querySelector('[name=telefoon]'));
  data.toestemming=box.querySelector('[name=toestemming]').checked;
  if(!data.toestemming)return err('Geef toestemming om gebeld te worden met een aanbod.');
  var lead=Object.assign({funnel:'hybride-warmtepomp',verzonden:new Date().toISOString()},data);
  /* Koppel hier uw leadverwerking: zet window.VD_SUBMIT_URL of luister naar het event 'vd:lead'. */
  try{(window.dataLayer=window.dataLayer||[]).push({event:'lead',funnel:'hybride-warmtepomp'})}catch(x){}
  document.dispatchEvent(new CustomEvent('vd:lead',{detail:lead}));
  if(window.VD_SUBMIT_URL){try{fetch(window.VD_SUBMIT_URL,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(lead)})}catch(x){}}
  document.body.classList.add('done');window.scrollTo(0,0);
 }
 document.addEventListener('click',function(e){
  var a=e.target.closest('[data-cta]');if(!a)return;e.preventDefault();
  var p=document.getElementById('check');p.scrollIntoView({behavior:'smooth',block:'start'});
  p.classList.add('flash');setTimeout(function(){p.classList.remove('flash')},1200);
  setTimeout(function(){var f=p.querySelector('.opt,input');if(f)f.focus({preventScroll:true})},500);
 });
 if(location.hash==='#bedankt')document.body.classList.add('done');
 render();
})();
</script>


