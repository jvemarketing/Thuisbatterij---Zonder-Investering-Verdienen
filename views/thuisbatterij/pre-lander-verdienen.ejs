<!DOCTYPE html>
<html lang="nl">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,shrink-to-fit=no" />
  <meta name="description"
    content="Verdien met je woning. Thuisbatterij + zonnepanelen + warmtepomp. Controleer subsidie in jouw gemeente." />
  <title>Verdien Duurzaam - Laat uw woning voor u verdienen</title>
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
  <style>
    :root {
      --or: #FF5A00;
      --ord: #cc4700;
      --orl: #fff3ec;
      --gr: #00a651;
      --dk: #1a1a1a;
      --rd: #e02020;
      --yw: #ffc107;
      --urgbar-h: 32px
    }

    @media (max-width: 575.98px) {
      :root { --urgbar-h: 50px }
    }

    html {
      scroll-behavior: smooth
    }

    body {
      font-family: 'Segoe UI', Arial, sans-serif;
      color: var(--dk);
      padding-top: calc(var(--urgbar-h) + 60px)
    }

    /* TOPBAR */
    #urgbar {
      background: var(--rd);
      color: #fff;
      font-size: .72rem;
      font-weight: 700;
      padding: 7px 10px;
      text-align: center;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 1060;
      line-height: 1.3;
      height: var(--urgbar-h)
    }

    .pulse {
      display: inline-block;
      width: 8px;
      height: 8px;
      background: #fff;
      border-radius: 50%;
      margin-right: 5px;
      animation: pulse 1.2s infinite
    }

    @keyframes pulse {

      0%,
      100% {
        opacity: 1;
        transform: scale(1)
      }

      50% {
        opacity: .3;
        transform: scale(.6)
      }
    }

    /* NAV */
    #mainNav {
      background: #0d1f3c;
      box-shadow: 0 2px 12px rgba(0, 0, 0, .3);
      position: fixed;
      top: var(--urgbar-h);
      left: 0;
      right: 0;
      z-index: 1050
    }

    #mainNav .navbar-brand {
      font-weight: 900;
      font-size: 1.05rem;
      color: #fff !important
    }

    #mainNav .navbar-brand span {
      color: var(--or)
    }

    #mainNav .nav-link {
      color: rgba(255, 255, 255, .8) !important;
      font-size: .83rem;
      font-weight: 600;
      padding: .45rem .8rem !important
    }

    #mainNav .nav-link:hover {
      color: #fff !important
    }

    .btn-nav {
      background: var(--or);
      color: #fff !important;
      border-radius: 50px;
      padding: .4rem 1rem !important;
      font-weight: 800;
      font-size: .78rem !important
    }

    .btn-nav:hover {
      background: var(--ord) !important
    }

    .navbar-toggler {
      border-color: rgba(255, 255, 255, .25)
    }

    .navbar-toggler-icon {
      background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='30' height='30' viewBox='0 0 30 30'%3e%3cpath stroke='rgba(255,255,255,.9)' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e")
    }

    /* HERO */
    #hero {
      background: linear-gradient(150deg, #0d1f3c, #1a3a6e);
      color: #fff;
      padding: 3rem 0 2.5rem;
      min-height: 90vh;
      display: flex;
      align-items: center
    }

    .hero-badge {
      display: inline-block;
      background: var(--or);
      color: #fff;
      font-size: .68rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      padding: 4px 13px;
      border-radius: 20px;
      margin-bottom: .9rem
    }

    #hero h1 {
      font-size: clamp(1.55rem, 5vw, 2.7rem);
      font-weight: 800;
      line-height: 1.2
    }

    #hero h1 span {
      color: var(--or)
    }

    #hero .lead {
      font-size: clamp(.88rem, 2.2vw, 1rem);
      opacity: .88;
      line-height: 1.65
    }

    /* POSTCODE CARD */
    .pcard {
      background: #fff;
      border-radius: 16px;
      box-shadow: 0 10px 40px rgba(0, 0, 0, .25);
      padding: 1.4rem
    }

    .pcard h5 {
      font-weight: 800;
      font-size: .95rem;
      color: var(--dk)
    }

    .pcard .form-control {
      font-size: 1.2rem;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      border: 2px solid #ddd;
      border-radius: 10px;
      padding: .75rem 1rem;
      height: auto
    }

    .pcard .form-control:focus {
      border-color: var(--or);
      box-shadow: 0 0 0 3px rgba(255, 90, 0, .15)
    }

    .pcard .form-control.is-invalid {
      border-color: var(--rd)
    }

    .btn-or {
      background: var(--or);
      color: #fff;
      font-weight: 800;
      border: none;
      border-radius: 10px;
      padding: .85rem 1rem;
      font-size: .95rem;
      min-height: 52px;
      width: 100%;
      transition: background .2s, transform .1s;
      display: flex;
      align-items: center;
      justify-content: center
    }

    .btn-or:hover {
      background: var(--ord);
      color: #fff;
      transform: scale(1.02)
    }

    .btn-pill {
      background: var(--or);
      color: #fff;
      font-weight: 800;
      border: none;
      border-radius: 50px;
      padding: .9rem 2rem;
      font-size: 1rem;
      transition: background .2s, transform .15s;
      animation: ctap 2.5s infinite;
      display: inline-flex;
      align-items: center
    }

    .btn-pill:hover {
      background: var(--ord);
      color: #fff;
      transform: scale(1.03)
    }

    /* Hide btn-pill on desktop */
    @media (min-width: 992px) {
      .btn-pill {
        display: none !important;
      }
    }

    @keyframes ctap {

      0%,
      100% {
        box-shadow: 0 6px 22px rgba(255, 90, 0, .35)
      }

      50% {
        box-shadow: 0 6px 32px rgba(255, 90, 0, .65), 0 0 0 8px rgba(255, 90, 0, .12)
      }
    }

    /* LIVE BAR */
    #livebar {
      background: var(--orl);
      border-top: 3px solid var(--or);
      border-bottom: 3px solid var(--or);
      padding: .9rem 0
    }

    .lnum {
      font-size: 1.65rem;
      font-weight: 900;
      color: var(--or);
      line-height: 1
    }

    .llbl {
      font-size: .65rem;
      color: #666;
      margin-top: 2px
    }

    /* TRUST */
    #trustrow {
      background: #fff;
      border-bottom: 1px solid #eee;
      padding: .8rem 0
    }

    .ti {
      display: flex;
      align-items: center;
      gap: .45rem;
      font-size: .75rem;
      font-weight: 600;
      color: #555;
      padding: .25rem 0
    }

    .ck {
      width: 19px;
      height: 19px;
      background: var(--gr);
      border-radius: 50%;
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: .6rem;
      flex-shrink: 0
    }

    /* SECTION */
    .spy {
      padding: 2.8rem 0
    }

    .slbl {
      display: inline-block;
      font-size: .68rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1.3px;
      color: var(--or);
      margin-bottom: .45rem
    }

    .stitle {
      font-size: clamp(1.25rem, 3.5vw, 1.9rem);
      font-weight: 800;
      line-height: 1.25
    }

    /* QUOTE */
    .qblock {
      background: #f0f4f9;
      border-left: 5px solid #0d2d55;
      border-radius: 0 10px 10px 0;
      padding: 1.1rem 1.3rem;
      margin: 1.4rem 0
    }

    .qblock blockquote {
      font-size: .9rem;
      font-style: italic;
      line-height: 1.7;
      color: #222;
      margin-bottom: .6rem
    }

    .rologo {
      flex-shrink: 0;
      display: block;
    }

    .rologo img {
      display: block;
      height: auto;
    }

    /* STEPS */
    .stepnum {
      width: 44px;
      height: 44px;
      background: var(--or);
      color: #fff;
      border-radius: 50%;
      font-size: 1.05rem;
      font-weight: 900;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0
    }

    /* REVIEWS */
    .rcard {
      background: #f9f9f9;
      border-radius: 12px;
      padding: 1.1rem;
      border: 1px solid #eee
    }

    .stars {
      color: var(--yw);
      letter-spacing: 2px;
      font-size: .88rem
    }

    .rtext {
      font-size: .82rem;
      line-height: 1.65;
      color: #555;
      font-style: italic;
      margin-bottom: .7rem
    }

    .ravatar {
      width: 35px;
      height: 35px;
      border-radius: 50%;
      background: var(--or);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: .82rem;
      flex-shrink: 0
    }

    .rname {
      font-weight: 700;
      font-size: .82rem
    }

    .rloc {
      font-size: .7rem;
      color: #aaa
    }

    .vbadge {
      display: inline-flex;
      align-items: center;
      gap: 3px;
      font-size: .68rem;
      color: var(--gr);
      font-weight: 600;
      margin-top: .35rem
    }

    .carousel-control-prev-icon,
    .carousel-control-next-icon {
      background-color: rgba(0, 0, 0, .22);
      border-radius: 50%;
      padding: 12px;
      background-size: 50%
    }

    /* FAQ */
    #faqsec {
      background: #f8f8f8
    }

    .fcard {
      border: 1px solid #e8e8e8 !important;
      border-radius: 10px !important;
      overflow: hidden;
      margin-bottom: .45rem
    }

    .fcard .card-header {
      background: #fff;
      border: none;
      padding: 0
    }

    .fbtn {
      color: var(--dk);
      font-weight: 700;
      font-size: .86rem;
      text-decoration: none;
      padding: .85rem 1rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      text-align: left
    }

    .fbtn:hover {
      text-decoration: none;
      color: var(--or)
    }

    .fbtn .fa {
      color: var(--or);
      transition: transform .25s;
      font-size: .78rem
    }

    .fbtn[aria-expanded="true"] .fa {
      transform: rotate(45deg)
    }

    .fcard .card-body {
      font-size: .82rem;
      line-height: 1.7;
      color: #666;
      padding: .75rem 1rem .95rem
    }

    /* MODAL */
    .mresult .modal-content {
      border-radius: 18px;
      border: none;
      box-shadow: 0 20px 60px rgba(0, 0, 0, .25)
    }

    .mresult .modal-header {
      border: none;
      padding: 1.4rem 1.4rem .4rem
    }

    .mresult .modal-body {
      padding: 0 1.4rem 1.4rem
    }

    .ric {
      font-size: 3rem;
      margin-bottom: .7rem
    }

    .spotbox {
      background: var(--orl);
      border: 1px solid #ffc8a0;
      border-radius: 8px;
      padding: .65rem .9rem;
      font-size: .8rem;
      color: var(--ord);
      font-weight: 700;
      margin-bottom: .9rem
    }

    /* TOASTS */
    #toastWrap {
      position: fixed;
      bottom: 76px;
      left: 12px;
      z-index: 1070;
      max-width: 280px
    }

    .ptoast {
      background: #fff;
      border-radius: 9px;
      box-shadow: 0 5px 22px rgba(0, 0, 0, .17);
      padding: .65rem .85rem;
      display: flex;
      align-items: center;
      gap: .55rem;
      border-left: 4px solid var(--gr);
      margin-bottom: .4rem;
      position: relative;
      animation: tin .35s ease
    }

    @keyframes tin {
      from {
        transform: translateX(-100%);
        opacity: 0
      }

      to {
        transform: translateX(0);
        opacity: 1
      }
    }

    .tic {
      font-size: 1.3rem;
      flex-shrink: 0
    }

    .ttx strong {
      font-size: .72rem;
      font-weight: 700;
      display: block;
      color: var(--dk)
    }

    .ttx span {
      font-size: .65rem;
      color: #aaa
    }

    .tcls {
      position: absolute;
      top: 5px;
      right: 7px;
      font-size: .7rem;
      color: #ccc;
      cursor: pointer;
      background: none;
      border: none;
      padding: 0
    }

    /* STICKY */
    #sbot {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: var(--dk);
      color: #fff;
      padding: .65rem .9rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: .6rem;
      z-index: 1050;
      box-shadow: 0 -3px 14px rgba(0, 0, 0, .2);
      transform: translateY(100%);
      transition: transform .4s
    }

    #sbot.vis {
      transform: translateY(0)
    }

    #sbot .stxt {
      font-size: .72rem;
      color: #bbb;
      line-height: 1.3
    }

    #sbot .stxt strong {
      color: #fff;
      display: block
    }

    .sbtn {
      background: var(--or);
      color: #fff;
      border: none;
      border-radius: 50px;
      padding: .55rem 1.1rem;
      font-size: .8rem;
      font-weight: 800;
      white-space: nowrap;
      flex-shrink: 0
    }

    /* FOOTER */
    footer {
      background: #0d1f3c;
      color: rgba(255, 255, 255, .65);
      padding: 2rem 0 1.4rem;
      font-size: .76rem
    }

    footer h6 {
      color: #fff;
      font-weight: 800;
      font-size: .78rem;
      margin-bottom: .7rem;
      text-transform: uppercase;
      letter-spacing: .7px
    }

    footer a {
      color: rgba(255, 255, 255, .55);
      text-decoration: none
    }

    footer a:hover {
      color: #fff
    }

    .fbrand {
      font-size: 1.05rem;
      font-weight: 900;
      color: #fff
    }

    .fbrand span {
      color: var(--or)
    }

    .fdiv {
      border-color: rgba(255, 255, 255, .1)
    }

    .fbot {
      color: rgba(255, 255, 255, .35);
      font-size: .68rem
    }

    @media(max-width:575px) {
      .tdig {
        width: 48px;
        height: 48px;
        font-size: 1.4rem
      }

      #sbot {
        padding: .55rem .75rem
      }
    }

    /* FLOW OVERLAY */
    .flow-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, .85);
      z-index: 2000;
      align-items: center;
      justify-content: center;
      padding: 1rem;
      overflow-y: auto
    }

    .flow-overlay.active {
      display: flex
    }

    .flow-container {
      background: #fff;
      border-radius: 20px;
      max-width: 520px;
      width: 100%;
      padding: 2rem 1.5rem;
      box-shadow: 0 20px 60px rgba(0, 0, 0, .4);
      position: relative;
      margin: auto
    }

    .flow-close {
      position: absolute;
      top: 1rem;
      right: 1rem;
      background: none;
      border: none;
      font-size: 1.5rem;
      color: #999;
      cursor: pointer;
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      transition: background .2s
    }

    .flow-close:hover {
      background: #f0f0f0
    }

    /* LOADER */
    .loader-wrap {
      text-align: center;
      padding: 2rem 1rem
    }

    .loader-title {
      font-size: 1.3rem;
      font-weight: 800;
      margin-bottom: .5rem;
      color: var(--dk)
    }

    .loader-subtitle {
      font-size: .9rem;
      color: #666;
      margin-bottom: 2rem
    }

    .loader-steps {
      margin: 2rem 0
    }

    .loader-step {
      display: flex;
      align-items: center;
      padding: .8rem 0;
      opacity: .3;
      transition: opacity .3s
    }

    .loader-step.active {
      opacity: 1
    }

    .loader-step.done {
      opacity: .6
    }

    .loader-step .ls-icon {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: #f0f0f0;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: .9rem;
      flex-shrink: 0;
      transition: background .3s
    }

    .loader-step.active .ls-icon {
      background: var(--or);
      color: #fff;
      animation: pulse-icon .8s infinite
    }

    .loader-step.done .ls-icon {
      background: var(--gr);
      color: #fff
    }

    @keyframes pulse-icon {

      0%,
      100% {
        transform: scale(1)
      }

      50% {
        transform: scale(1.1)
      }
    }

    .loader-step .ls-text {
      font-weight: 600;
      font-size: .9rem
    }

    .loader-bar {
      background: #e8e8e8;
      height: 8px;
      border-radius: 20px;
      overflow: hidden;
      margin-top: 2rem
    }

    .loader-bar-fill {
      background: linear-gradient(90deg, var(--or), #ff8c00);
      height: 100%;
      width: 0;
      transition: width .6s ease;
      border-radius: 20px
    }

    /* QUESTION FLOW */
    .question-wrap {
      text-align: center;
      padding: 1rem 0
    }

    .q-progress {
      display: flex;
      justify-content: center;
      gap: .4rem;
      margin-bottom: 1.5rem
    }

    .q-dot {
      width: 8px;
      height: 8px;
      background: #ddd;
      border-radius: 50%;
      transition: background .3s, width .3s
    }

    .q-dot.active {
      background: var(--or);
      width: 24px;
      border-radius: 4px
    }

    .q-number {
      font-size: .8rem;
      color: var(--or);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: .5rem
    }

    .q-title {
      font-size: 1.4rem;
      font-weight: 800;
      line-height: 1.3;
      margin-bottom: 1.5rem;
      color: var(--dk)
    }

    .q-options {
      display: flex;
      flex-direction: column;
      gap: .7rem;
      margin-bottom: 1.5rem
    }

    .q-option {
      background: #fff;
      border: 2px solid #e0e0e0;
      border-radius: 12px;
      padding: 1rem 1.2rem;
      font-size: .95rem;
      font-weight: 600;
      color: var(--dk);
      cursor: pointer;
      transition: all .2s;
      text-align: left;
      display: flex;
      align-items: center;
      min-height: 60px
    }

    .q-option:hover {
      border-color: var(--or);
      background: var(--orl);
      transform: translateX(4px)
    }

    .q-option:active {
      transform: scale(.98)
    }

    .q-option.selected {
      border-color: var(--or);
      background: var(--or);
      color: #fff
    }

    .q-option-icon {
      font-size: 1.3rem;
      margin-right: .8rem;
      flex-shrink: 0
    }

    .q-nav {
      display: flex;
      gap: .6rem;
      justify-content: center
    }

    .q-btn {
      border: none;
      border-radius: 50px;
      padding: .7rem 1.8rem;
      font-size: .9rem;
      font-weight: 800;
      cursor: pointer;
      transition: all .2s;
      min-width: 110px
    }

    .q-btn-back {
      background: #f0f0f0;
      color: #666
    }

    .q-btn-back:hover {
      background: #e0e0e0
    }

    .q-btn-next {
      background: var(--or);
      color: #fff
    }

    .q-btn-next:hover {
      background: var(--ord)
    }

    .q-btn-next:disabled {
      background: #ccc;
      cursor: not-allowed
    }

    /* FINAL FORM */
    .final-form-wrap {
      padding: 1rem 0
    }

    .final-form-title {
      font-size: 1.5rem;
      font-weight: 800;
      margin-bottom: .5rem;
      text-align: center
    }

    .final-form-subtitle {
      font-size: .88rem;
      color: #666;
      margin-bottom: 1.5rem;
      text-align: center
    }

    .ff-group {
      margin-bottom: 1rem
    }

    .ff-label {
      font-size: .82rem;
      font-weight: 700;
      color: var(--dk);
      margin-bottom: .4rem;
      display: block
    }

    .ff-input {
      width: 100%;
      border: 2px solid #ddd;
      border-radius: 10px;
      padding: .75rem 1rem;
      font-size: .95rem;
      transition: border-color .2s
    }

    .ff-input:focus {
      outline: none;
      border-color: var(--or);
      box-shadow: 0 0 0 3px rgba(255, 90, 0, .1)
    }

    .ff-input.error {
      border-color: var(--rd)
    }

    .ff-error {
      color: var(--rd);
      font-size: .75rem;
      margin-top: .3rem;
      display: none
    }

    .ff-input.error~.ff-error {
      display: block
    }

    .ff-checkbox {
      display: flex;
      align-items: start;
      gap: .6rem;
      margin: 1rem 0
    }

    .ff-checkbox input {
      flex-shrink: 0;
      margin-top: .2rem
    }

    .ff-checkbox label {
      font-size: .8rem;
      color: #666;
      line-height: 1.5
    }

