  <script>
    // Simple postcode validation and redirect - no jQuery needed
    function checkPostcode(inputId, buttonId) {
      console.log('=== checkPostcode called ===');
      console.log('inputId:', inputId, 'buttonId:', buttonId);

      var input = document.getElementById(inputId);
      var button = document.getElementById(buttonId);

      console.log('input element:', input);
      console.log('button element:', button);

      if (!input || !button) {
        alert('Error: Elements not found - input: ' + !!input + ', button: ' + !!button);
        return;
      }

      var postcode = input.value.trim().toUpperCase();
      console.log('Postcode entered:', postcode);

      // Validate Dutch postcode format: 1234AB or 1234 AB
      var isValid = /^[1-9][0-9]{3}\s?[A-Z]{2}$/.test(postcode);
      console.log('Is valid:', isValid);

      if (!isValid) {
        alert('Voer een geldige postcode in (bijvoorbeeld: 1234 AB)');
        input.focus();
        return;
      }

      // Show loading
      console.log('Showing loading state...');
      button.innerHTML = '⏳ Controleren...';
      button.disabled = true;

      // Redirect after short delay, preserving tracking params
      console.log('Setting timeout for redirect...');
      setTimeout(function () {
        var redirectUrl = '/thuisbatterij/flow?pc=' + encodeURIComponent(postcode);

        // Append tracking parameters using affiliate module
        redirectUrl = AffiliateTracking.appendToUrl(redirectUrl);

        console.log('REDIRECTING TO:', redirectUrl);
        console.log('Current location:', window.location.href);
        window.location.href = redirectUrl;
      }, 800);
    }

    // Scroll to postcode form and vertically center it in the viewport
    function scrollToCheck() {
      var form = document.getElementById('postcodeForm');
      if (!form) return;
      var rect = form.getBoundingClientRect();
      var formCenterY = window.pageYOffset + rect.top + rect.height / 2;
      var targetY = formCenterY - window.innerHeight / 2;
      window.scrollTo({ top: Math.max(0, targetY), behavior: 'smooth' });
      setTimeout(function () {
        var input = document.getElementById('hpc');
        if (input) input.focus();
      }, 600);
    }

    // Auto-uppercase postcode inputs
    document.addEventListener('DOMContentLoaded', function () {
      var inputs = document.querySelectorAll('input[type=text]');
      inputs.forEach(function (input) {
        input.addEventListener('input', function () {
          this.value = this.value.toUpperCase();
        });
      });

      // Dynamic counter - resets daily, grows throughout the day
      function getDailyCount() {
        var now = new Date();
        var dayStart = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 0, 0, 0);
        var minutesSinceMidnight = Math.floor((now - dayStart) / 60000);
        // Start at 3800, add ~1 signup per 3 minutes throughout the day
        return 3800 + Math.floor(minutesSinceMidnight / 3);
      }

      var count = getDailyCount();
      var counterEl = document.getElementById('signcnt');
      if (counterEl) {
        counterEl.textContent = count.toLocaleString('nl-NL');
      }

      setInterval(function () {
        if (Math.random() > 0.55) {
          count++;
          if (counterEl) {
            counterEl.textContent = count.toLocaleString('nl-NL');
          }
        }
      }, 9500);

    });
  </script>
  
