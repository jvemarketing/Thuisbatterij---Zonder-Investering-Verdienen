</head>
<body>

<!-- URGENCY BAR -->
<div class="urgbar">
  <span class="pulse"></span>
  Saldering stopt per 1 januari 2027 - bereken nu wat een thuisbatterij u oplevert
</div>

<!-- LOADER (shown first) -->
