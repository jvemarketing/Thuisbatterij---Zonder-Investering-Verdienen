      {text: 'In de garage', val: 'garage'},
      {text: 'In de meterkast', val: 'meterkast'},
      {text: 'Op zolder', val: 'zolder'},
      {text: 'In de kelder', val: 'kelder'},
      {text: 'Weet ik nog niet', val: 'onbekend'}
    ]
  },
  q6: {
    title: 'Wanneer wil je de batterij laten plaatsen?',
    options: [
      {text: 'Zo snel mogelijk', val: 'zsm'},
      {text: 'Over 2 tot 4 weken', val: '2-4w'},
      {text: 'Over 4 tot 8 weken', val: '4-8w'},
      {text: 'Weet ik nog niet', val: 'onbekend'}
    ]
  }
};

// Build the active question sequence based on answers (branching)
function computeSteps(){
  var steps = ['q1'];
  if(answers.q1 === 'woning') steps.push('q1b');
  steps.push('q2', 'q3');
  if(answers.q3 === 'ja') steps.push('q3a', 'q3b');
  steps.push('q4', 'q5', 'q6');
  return steps;
}

// Determine lead routing segment
function computeSegment(){
  if(answers.q1 === 'bedrijf') return 'bedrijfspand';
  if(answers.q1b === 'huur') return 'woning-huur';
  return 'woning-koop';
}

