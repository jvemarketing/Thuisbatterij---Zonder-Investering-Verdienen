      <div class="usp-item"><svg class="usp-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" d="M5 12.5l4.5 4.5L19 7"/></svg> Zonder investering</div>
      <div class="usp-item"><svg class="usp-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" d="M5 12.5l4.5 4.5L19 7"/></svg> BTW-teruggave</div>
      <div class="usp-item"><svg class="usp-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" d="M5 12.5l4.5 4.5L19 7"/></svg> Verdien direct</div>
    </div>
  </div>

  <!-- MINI REVIEWS -->
  <div class="reviews-mini">
    <div class="reviews-title">4.8 uit 2.400+ reviews</div>
