<!-- FAQ -->
<section id="faqsec" class="spy" aria-labelledby="faqh">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-12 col-md-8">
        <div class="text-center mb-4">
          <span class="slbl">Veelgestelde vragen</span>
          <h2 class="stitle" id="faqh">De vragen die iedereen stelt over de thuisbatterij.</h2>
        </div>
