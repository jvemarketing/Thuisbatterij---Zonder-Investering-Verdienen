<script>
// Simple postcode validation and redirect - no jQuery needed
function checkPostcode(inputId, buttonId) {
  console.log('=== checkPostcode called ===');
  console.log('inputId:', inputId, 'buttonId:', buttonId);
  
  var input = document.getElementById(inputId);
  var button = document.getElementById(buttonId);
  
  console.log('input element:', input);
  console.log('button element:', button);
  
  if (!input || !button) {
    alert('Error: Elements not found - input: ' + !!input + ', button: ' + !!button);
    return;
  }
  
  var postcode = input.value.trim().toUpperCase();
  console.log('Postcode entered:', postcode);
  
  // Validate Dutch postcode format: 1234AB or 1234 AB
  var isValid = /^[1-9][0-9]{3}\s?[A-Z]{2}$/.test(postcode);
  console.log('Is valid:', isValid);
  
  if (!isValid) {
    alert('Voer een geldige postcode in (bijvoorbeeld: 1234 AB)');
    input.focus();
    return;
  }
  
  // Show loading
  console.log('Showing loading state...');
  button.innerHTML = '⏳ Controleren...';
  button.disabled = true;
  
  // Redirect after short delay, preserving tracking params
  console.log('Setting timeout for redirect...');
  setTimeout(function() {
    var redirectUrl = '/thuisbatterij-saldering/flow?pc=' + encodeURIComponent(postcode);

    // Append tracking parameters using affiliate module
    redirectUrl = AffiliateTracking.appendToUrl(redirectUrl);

    console.log('REDIRECTING TO:', redirectUrl);
    console.log('Current location:', window.location.href);
    window.location.href = redirectUrl;
  }, 800);
}

// Scroll to final CTA
function scrollToCheck() {
  var hero = document.getElementById('hero');
  if (hero) {
    hero.scrollIntoView({ behavior: 'smooth' });
    setTimeout(function() {
      var input = document.getElementById('hpc');
      if (input) input.focus();
    }, 600);
  }
}

// Auto-uppercase postcode inputs
document.addEventListener('DOMContentLoaded', function() {
  // Weeks until 1 January 2027
  (function(){
    var el = document.getElementById('weeksLeft');
    if (!el) return;
    var now = new Date();
    var target = new Date(2027, 0, 1);
    var weeks = Math.ceil((target - now) / (7 * 24 * 60 * 60 * 1000));
    if (weeks < 0) weeks = 0;
    el.textContent = weeks + (weeks === 1 ? ' week' : ' weken');
  })();

  var inputs = document.querySelectorAll('input[type=text]');
  inputs.forEach(function(input) {
    input.addEventListener('input', function() {
      this.value = this.value.toUpperCase();
    });
  });
  
  
  
});



// Manual Tabs functionality for product tabs
document.addEventListener('DOMContentLoaded', function() {
  console.log('Setting up product tabs...');
  
  var tabLinks = document.querySelectorAll('#ctabs .nav-link');
  var tabPanes = document.querySelectorAll('.tab-content .tab-pane');
  
  console.log('Found tab links:', tabLinks.length);
  console.log('Found tab panes:', tabPanes.length);
  
  tabLinks.forEach(function(link) {
    link.addEventListener('click', function(e) {
      e.preventDefault();
      
      var targetId = this.getAttribute('href');
      console.log('Tab clicked:', targetId);
      
      // Remove active from all links
      tabLinks.forEach(function(l) {
        l.classList.remove('active');
        l.setAttribute('aria-selected', 'false');
      });
      
      // Remove active from all panes
      tabPanes.forEach(function(pane) {
        pane.classList.remove('show', 'active');
      });
      
      // Add active to clicked link
      this.classList.add('active');
      this.setAttribute('aria-selected', 'true');
      
      // Add active to target pane
      var targetPane = document.querySelector(targetId);
      if (targetPane) {
        targetPane.classList.add('show', 'active');
        console.log('Activated tab:', targetId);
      } else {
        console.error('Target pane not found:', targetId);
      }
    });
  });
  
  console.log('Product tabs initialized');
});

// Manual Carousel functionality for reviews
document.addEventListener('DOMContentLoaded', function() {
  console.log('Setting up reviews carousel...');
  
  var carousel = document.getElementById('revcar');
  if (!carousel) {
    console.error('Carousel not found');
    return;
  }
  
  var items = carousel.querySelectorAll('.carousel-item');
  var indicators = carousel.querySelectorAll('.carousel-indicators li');
  var currentIndex = 0;
  var autoPlayInterval;
  
  console.log('Found carousel items:', items.length);
  console.log('Found indicators:', indicators.length);
  
  function showSlide(index) {
    // Remove active from all
    items.forEach(function(item) {
      item.classList.remove('active');
    });
    indicators.forEach(function(ind) {
      ind.classList.remove('active');
    });
    
    // Add active to current
    if (items[index]) {
      items[index].classList.add('active');
      console.log('Showing slide:', index);
    }
    if (indicators[index]) {
      indicators[index].classList.add('active');
    }
    
    currentIndex = index;
  }
  
  function nextSlide() {
    var next = (currentIndex + 1) % items.length;
    showSlide(next);
  }
  
  function prevSlide() {
    var prev = (currentIndex - 1 + items.length) % items.length;
    showSlide(prev);
  }
  
  // Auto-play every 5 seconds
  function startAutoPlay() {
    autoPlayInterval = setInterval(nextSlide, 5000);
  }
  
  function stopAutoPlay() {
    clearInterval(autoPlayInterval);
  }
  
  // Next/Prev buttons
  var nextBtn = carousel.querySelector('.carousel-control-next');
  var prevBtn = carousel.querySelector('.carousel-control-prev');
  
  if (nextBtn) {
    nextBtn.addEventListener('click', function(e) {
      e.preventDefault();
      stopAutoPlay();
      nextSlide();
      startAutoPlay();
    });
  }
  
  if (prevBtn) {
    prevBtn.addEventListener('click', function(e) {
      e.preventDefault();
      stopAutoPlay();
      prevSlide();
      startAutoPlay();
    });
  }
  
  // Indicators click
  indicators.forEach(function(indicator, index) {
    indicator.addEventListener('click', function(e) {
      e.preventDefault();
      stopAutoPlay();
      showSlide(index);
      startAutoPlay();
    });
  });
  
  // Start auto-play
  startAutoPlay();
  console.log('Carousel auto-play started');
  
  // Pause on hover
  carousel.addEventListener('mouseenter', stopAutoPlay);
  carousel.addEventListener('mouseleave', startAutoPlay);
});

// Manual FAQ accordion functionality
document.addEventListener('DOMContentLoaded', function() {
  console.log('Setting up FAQ accordion...');
  
  var faqButtons = document.querySelectorAll('.fbtn');
  console.log('Found FAQ buttons:', faqButtons.length);
  
  faqButtons.forEach(function(button) {
    button.addEventListener('click', function(e) {
      e.preventDefault();
      console.log('FAQ button clicked');
      
      var targetId = this.getAttribute('data-target');
      var target = document.querySelector(targetId);
      
      if (!target) {
        console.error('Target not found:', targetId);
        return;
      }
      
      var isExpanded = this.getAttribute('aria-expanded') === 'true';
      
      // Close all other items
      document.querySelectorAll('#faqacc .collapse').forEach(function(collapse) {
        if (collapse !== target) {
          collapse.classList.remove('show');
          var btn = document.querySelector('[data-target="#' + collapse.id + '"]');
          if (btn) {
            btn.setAttribute('aria-expanded', 'false');
            btn.classList.add('collapsed');
          }
        }
      });
      
      // Toggle current item
      if (isExpanded) {
        target.classList.remove('show');
        this.setAttribute('aria-expanded', 'false');
        this.classList.add('collapsed');
      } else {
        target.classList.add('show');
        this.setAttribute('aria-expanded', 'true');
        this.classList.remove('collapsed');
      }
      
      console.log('Toggled FAQ item:', targetId, 'Now expanded:', !isExpanded);
    });
  });
});

</script>

